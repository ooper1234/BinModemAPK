@@ -30,6 +30,13 @@ const PATTERN: usize = (H as usize + 1) * INTERVALS;
 /// Codewords between one DIL segment and the next.
 const ORDER_STEP: usize = 3;
 
+/// Passes over the codewords the DIL asks for: two, a long DIL of about
+/// 0.88 s under mu-law, so every codeword is read ten times an interval and
+/// the noise each is read with is known half again as well (sqrt 2) as one
+/// pass gives -- the rate chosen at its end then rests on firmer ground.
+/// Android build: upstream asks for one pass, 0.44 s.
+const PASSES: usize = 2;
+
 /// The loudest codeword the DIL asks for, and so the loudest any
 /// constellation uses, as a fraction of full scale.
 ///
@@ -115,11 +122,15 @@ pub fn design(law: Law, uinfo: u8) -> Descriptor {
     let mut scrambler = crate::v32::Scrambler::new(crate::v32::Mode::Answer);
     let signs: Vec<bool> = (0..PATTERN).map(|_| scrambler.scramble(true)).collect();
     let training: Vec<bool> = (0..PATTERN).map(|n| n >= INTERVALS).collect();
-    let ucodes = (0..ORDER_STEP)
+    let pass: Vec<u8> = (0..ORDER_STEP)
         .flat_map(|first| (first..UCODES).step_by(ORDER_STEP))
         .map(|u| u as u8)
         .filter(|&u| u != uinfo && ucode::level(law, u) <= LOUDEST)
         .collect();
+    // The long DIL: the pass asked for PASSES times over, as many whole
+    // passes as the descriptor's 255 segments hold.
+    let passes = PASSES.min(255 / pass.len().max(1)).max(1);
+    let ucodes = pass.iter().copied().cycle().take(pass.len() * passes).collect();
     Descriptor { signs, training, h: [H; 8], refs: [uinfo; 8], ucodes }
 }
 
