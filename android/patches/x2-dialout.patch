diff --git a/crates/datapump/tests/x2_dialout.rs b/crates/datapump/tests/x2_dialout.rs
new file mode 100644
index 0000000..3c23521
--- /dev/null
+++ b/crates/datapump/tests/x2_dialout.rs
@@ -0,0 +1,295 @@
+//! The x2 caller (`x2::dialout`) against the x2 server, from phase 2, on a
+//! line that carries G.711 itself: the server's octets reach the caller as
+//! they were sent, as on a SIP call in PCMU -- and, in one test, with
+//! packets lost on the way, as on a real one.
+//!
+//! Both ends are written from the same facts (libv90modem's x2-facts), so
+//! this shows the caller and the server agree, not that either is x2.
+
+use std::collections::VecDeque;
+
+use datapump::v90::server::Line as ServerLine;
+use datapump::v90::startup::{Digital, Status};
+use datapump::x2::dialout::Modem as Caller;
+
+/// Each way's delay at 8000 Hz: 10 ms.
+const DELAY: usize = 80;
+/// A SIP packet: 20 ms of PCMU.
+const PACKET: usize = 160;
+
+/// The two ends at the network's rate. `lose(n)` drops the downstream
+/// octet the server made at sample `n`, as a network that lost its packet
+/// does (the receiving end's jitter buffer closes the gap).
+struct Call {
+    server: Digital,
+    caller: Caller,
+    to_server: VecDeque<f64>,
+    to_caller: VecDeque<f64>,
+    now: usize,
+}
+
+impl Call {
+    fn new(server: Digital) -> Self {
+        Self {
+            server,
+            caller: Caller::new(8000.0, 0.0),
+            to_server: vec![0.0; DELAY].into(),
+            to_caller: vec![0.0; DELAY].into(),
+            now: 0,
+        }
+    }
+
+    fn run(&mut self, seconds: f64, lose: &impl Fn(usize) -> bool, until: impl Fn(&Self) -> bool) {
+        for _ in 0..(seconds * 8000.0) as usize {
+            let s = self.server.step(self.to_server.pop_front().unwrap());
+            if !lose(self.now) {
+                self.to_caller.push_back(s);
+            }
+            // A jitter buffer plays something while it waits: the last
+            // packet's silence, as an underrun does.
+            let level = self.to_caller.pop_front().unwrap_or(0.0);
+            self.caller.give_exact(&[level]);
+            let c = self.caller.step(level);
+            self.to_server.push_back(c);
+            self.now += 1;
+            if until(self) {
+                return;
+            }
+        }
+    }
+
+    fn connected(&self) -> bool {
+        matches!(self.server.status(), Status::Connected { .. }) && matches!(self.caller.status(), Status::Connected { .. })
+    }
+
+    /// Data both ways: what each end sends the other reads.
+    fn carries_data(&mut self, n: usize, lose: &impl Fn(usize) -> bool) {
+        let down: Vec<bool> = (0..n).map(|k| (k * 7919) % 11 < 5).collect();
+        let up: Vec<bool> = (0..n).map(|k| (k * 104_729) % 13 < 6).collect();
+        self.server.take_bits();
+        self.caller.take_bits();
+        self.server.send_bits(&down);
+        self.caller.send_bits(&up);
+        let (mut got_down, mut got_up) = (Vec::new(), Vec::new());
+        for _ in 0..400 {
+            self.run(0.01, lose, |_| false);
+            got_down.extend(self.caller.take_bits());
+            got_up.extend(self.server.take_bits());
+        }
+        let find = |got: &[bool], sent: &[bool]| got.windows(sent.len()).any(|w| w == sent);
+        assert!(find(&got_down, &down), "downstream data did not arrive ({} bits read)", got_down.len());
+        assert!(find(&got_up, &up), "upstream data did not arrive ({} bits read)", got_up.len());
+    }
+
+    fn notes(&mut self) -> String {
+        self.caller.take_notes().join("; ")
+    }
+}
+
+#[test]
+fn an_x2_call_dialled_out_reaches_data_and_moves_up_to_56000() {
+    let never = |_: usize| false;
+    let mut call = Call::new(Digital::x2(0.0));
+    call.run(40.0, &never, Call::connected);
+    assert!(call.server.is_x2(), "server not x2: {} / {}", call.server.phase(), call.caller.phase());
+    assert!(call.caller.is_x2());
+    assert_eq!(call.caller.status(), Status::Connected { receive: 32_000, transmit: 28_800 }, "{}", call.notes());
+    // Clean: the caller asks for the top rate, and gets it.
+    call.run(15.0, &never, |c| c.connected() && matches!(c.caller.status(), Status::Connected { receive: 56_000, .. }));
+    assert_eq!(call.caller.status(), Status::Connected { receive: 56_000, transmit: 28_800 }, "{}", call.notes());
+    assert_eq!(call.server.status(), Status::Connected { transmit: 56_000, receive: 28_800 }, "{}", call.server.phase());
+    assert_eq!(call.caller.client().bad_frames, 0);
+    call.carries_data(8000, &never);
+}
+
+#[test]
+fn packets_lost_on_the_way_down_do_not_stop_the_call() {
+    // A 20 ms packet lost in the TRN, one in the ones, and one every
+    // 1.5 s from data mode on (once it is reached at some 9 s).
+    let lose = |n: usize| {
+        let packet = n / PACKET;
+        packet == 400 || packet == 520 || (n > 12 * 8000 && packet % 75 == 0)
+    };
+    let mut call = Call::new(Digital::x2(0.0));
+    call.run(45.0, &lose, |c| c.connected() && matches!(c.caller.status(), Status::Connected { receive: 56_000, .. }));
+    assert!(call.connected(), "{:?} / {:?} at {}: {}", call.server.status(), call.caller.status(), call.caller.phase(), call.notes());
+    assert!(call.caller.client().resyncs > 0, "no packet loss was seen");
+    call.carries_data(4000, &lose);
+}
+
+#[test]
+fn a_far_end_that_offers_no_x2_gets_a_v34_call() {
+    // V.34's answer modem, which is what V.8 gives a caller offering V.34
+    // and no PCM when the far end has no x2: its INFO0a says nothing of it.
+    use datapump::v34::phase2::Role;
+    use datapump::v34::startup::{Modem as V34, Status as V34Status};
+    let mut answerer = V34::new(Role::Answer, 8000.0);
+    let mut caller = Caller::new(8000.0, 0.0);
+    let mut to_answerer: VecDeque<f64> = vec![0.0; DELAY].into();
+    let mut to_caller: VecDeque<f64> = vec![0.0; DELAY].into();
+    for _ in 0..(30.0 * 8000.0) as usize {
+        let a = answerer.step(to_answerer.pop_front().unwrap());
+        to_caller.push_back(a);
+        let c = caller.step(to_caller.pop_front().unwrap());
+        to_answerer.push_back(c);
+        if matches!(answerer.status(), V34Status::Connected { .. }) && matches!(caller.status(), Status::Connected { .. }) {
+            break;
+        }
+    }
+    assert!(!caller.is_x2());
+    assert!(matches!(caller.status(), Status::Connected { .. }), "{:?}: {}", caller.status(), caller.take_notes().join("; "));
+}
+
+/// At a line rate of 16000 Hz, through the rate conversions both ends do on
+/// a sound-card-rate line, with the octets handed across exactly as a SIP
+/// line does.
+#[test]
+fn at_the_line_rate_with_the_octets_handed_across() {
+    let fs = 16_000.0;
+    let mut server = ServerLine::x2(fs, 0.0);
+    let mut caller = Caller::new(fs, 0.0);
+    let mut to_caller: VecDeque<f64> = vec![0.0; 2 * DELAY].into();
+    let mut to_server: VecDeque<f64> = vec![0.0; 2 * DELAY].into();
+    let mut levels = Vec::new();
+    let mut connected = false;
+    for _ in 0..(40.0 * fs) as usize {
+        let s = server.step(to_server.pop_front().unwrap());
+        levels.clear();
+        server.take_exact(&mut levels);
+        caller.give_exact(&levels);
+        to_caller.push_back(s);
+        // At the window's drive for a modem that is not sending levels.
+        let c = caller.step(to_caller.pop_front().unwrap()) * 0.1;
+        to_server.push_back(c);
+        if matches!(server.status(), Status::Connected { .. }) && matches!(caller.status(), Status::Connected { .. }) {
+            connected = true;
+            break;
+        }
+    }
+    assert!(connected, "{:?} / {:?} at {}: {}", server.status(), caller.status(), caller.phase(), caller.take_notes().join("; "));
+    assert!(caller.is_x2());
+    // And data both ways, through the rate change to 56000 and after.
+    let n = 6000;
+    let down: Vec<bool> = (0..n).map(|k| (k * 7919) % 11 < 5).collect();
+    let up: Vec<bool> = (0..n).map(|k| (k * 104_729) % 13 < 6).collect();
+    let (mut got_down, mut got_up) = (Vec::new(), Vec::new());
+    let mut sent = false;
+    for k in 0..(10.0 * fs) as usize {
+        if !sent && k > (5.0 * fs) as usize {
+            server.modem_mut().take_bits();
+            caller.take_bits();
+            got_down.clear();
+            got_up.clear();
+            server.modem_mut().send_bits(&down);
+            caller.send_bits(&up);
+            sent = true;
+        }
+        let s = server.step(to_server.pop_front().unwrap());
+        levels.clear();
+        server.take_exact(&mut levels);
+        caller.give_exact(&levels);
+        to_caller.push_back(s);
+        let c = caller.step(to_caller.pop_front().unwrap()) * 0.1;
+        to_server.push_back(c);
+        got_down.extend(caller.take_bits());
+        got_up.extend(server.modem_mut().take_bits());
+    }
+    let find = |got: &[bool], sent: &[bool]| got.windows(sent.len()).any(|w| w == sent);
+    assert!(matches!(caller.status(), Status::Connected { receive: 56_000, .. }), "{:?}: {}", caller.status(), caller.take_notes().join("; "));
+    assert!(find(&got_down, &down), "downstream data did not arrive ({} bits read)", got_down.len());
+    assert!(find(&got_up, &up), "upstream data did not arrive ({} bits read)", got_up.len());
+}
+
+
+/// Every upstream bit, at the line rate, from data mode to the rate change:
+/// the client's encoder takes a mapping frame of bits at a time, and a
+/// caller that kept fewer queued got ones in the middle of its data.
+#[test]
+fn the_upstream_arrives_bit_for_bit() {
+    let fs = 16_000.0;
+    let mut server = ServerLine::x2(fs, 0.0);
+    let mut caller = Caller::new(fs, 0.0);
+    let mut to_caller: VecDeque<f64> = vec![0.0; 2 * DELAY].into();
+    let mut to_server: VecDeque<f64> = vec![0.0; 2 * DELAY].into();
+    let mut levels = Vec::new();
+    let mut state = 99u32;
+    let mut sent: Vec<bool> = Vec::new();
+    let mut got: Vec<bool> = Vec::new();
+    let mut started = false;
+    for k in 0..(40.0 * fs) as usize {
+        let s = server.step(to_server.pop_front().unwrap());
+        levels.clear();
+        server.take_exact(&mut levels);
+        caller.give_exact(&levels);
+        to_caller.push_back(s);
+        let c = caller.step(to_caller.pop_front().unwrap()) * 0.1;
+        to_server.push_back(c);
+        if matches!(caller.status(), Status::Connected { .. }) && !started && k % 1000 == 0 {
+            started = true;
+            server.modem_mut().take_bits();
+        }
+        if started {
+            // Keep 64 queued, as the modem does.
+            while caller.pending_bits() < caller.fill_bits() {
+                state = state.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+                let b = state >> 31 == 1;
+                sent.push(b);
+                caller.send_bits(&[b]);
+            }
+            got.extend(server.modem_mut().take_bits());
+        }
+    }
+    // Find where `sent` begins in `got`.
+    let probe = &sent[..64];
+    let at = got.windows(64).position(|w| w == probe).expect("start not found");
+    let got = &got[at..];
+    let n = got.len().min(sent.len());
+    let errors: Vec<usize> = (0..n).filter(|&i| got[i] != sent[i]).collect();
+    // Up to the rate change, two seconds in: what is in flight at the
+    // change is lost, as across a retrain, and V.42 sends it again.
+    let clean = 50_000.min(n);
+    assert!(clean == 50_000, "only {n} bits arrived");
+    assert_eq!(errors.iter().filter(|&&i| i < clean).count(), 0, "first wrong bits at {:?}", errors.iter().take(10).collect::<Vec<_>>());
+    // And after it, the stream again, whole.
+    let w = &got[n - 2000..n - 1000];
+    assert!(sent.windows(1000).any(|x| x == w), "the upstream after the rate change is not what was sent");
+}
+
+/// The same through upstream's own client, from phase 2, at the network's
+/// rate.
+#[test]
+fn the_simulated_clients_upstream_arrives_bit_for_bit() {
+    use datapump::x2::client::Client;
+    let mut server = Digital::x2(0.0);
+    let mut client = Client::from_phase2();
+    let mut to_server: VecDeque<f64> = vec![0.0; DELAY].into();
+    let mut to_client: VecDeque<f64> = vec![0.0; DELAY].into();
+    let mut state = 99u32;
+    let (mut sent, mut got) = (Vec::new(), Vec::new());
+    let mut started = false;
+    for k in 0..(30.0 * 8000.0) as usize {
+        let s = server.step(to_server.pop_front().unwrap());
+        let c = client.step(to_client.pop_front().unwrap());
+        to_client.push_back(s);
+        to_server.push_back(c);
+        if client.in_data() && !started && k % 1000 == 0 {
+            started = true;
+            server.take_bits();
+        }
+        if started {
+            while client.pending_bits() < client.fill_bits() {
+                state = state.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+                let b = state >> 31 == 1;
+                sent.push(b);
+                client.send_bits(&[b]);
+            }
+            got.extend(server.take_bits());
+        }
+    }
+    let at = got.windows(64).position(|w| w == &sent[..64]).expect("start not found");
+    let got = &got[at..];
+    let n = got.len().min(sent.len());
+    let errors = (0..n).filter(|&i| got[i] != sent[i]).count();
+    assert!(n > 500_000, "{n} bits");
+    assert_eq!(errors, 0, "{errors} of {n} bits wrong");
+}
