diff --git a/crates/datapump/src/x2/dialout.rs b/crates/datapump/src/x2/dialout.rs
new file mode 100644
index 0000000..5a5ca00
--- /dev/null
+++ b/crates/datapump/src/x2/dialout.rs
@@ -0,0 +1,378 @@
+//! U.S. Robotics x2, the calling side: a client that dials out to an x2
+//! server, at the line's rate.
+//!
+//! Phase 2 is V.34's call modem's own, up to the server's INFO0a. A server
+//! that offers x2 there -- bit 23 or bit 24 (x2-facts, "Phase 2 marker"; see
+//! `phase2::Modem::answering_x2`) -- gets the client's marker 190 ms after
+//! its L1 begins and no L1, L2 or INFO1c of the client's own; then the x2
+//! client ([`super::client::Client`]) takes the call from phase 3. A server
+//! that does not offer it gets a V.34 caller to the end: the call is V.34's.
+//!
+//! The x2 downstream is G.711 octets that the client reads as octets. On a
+//! line that carries G.711 itself (a SIP call in PCMU) they arrive as they
+//! were sent, and [`Modem::give_exact`] hands them over; anywhere else they
+//! have been through a codec and a sound card, and only an analogue
+//! receiver -- equaliser, timing, levels learnt from the line -- could read
+//! them, which this is not. So x2 here is for SIP lines.
+
+use std::collections::VecDeque;
+
+use dsp::Resampler;
+
+use super::client::{Client, FS};
+use crate::v34::dpsk;
+use crate::v34::info::{Info0, X2Marker};
+use crate::v34::phase2::Role;
+use crate::v34::startup;
+use crate::v90::startup::Status;
+
+/// The server's L1 lasts 160 ms; the marker follows 10 to 100 ms after it
+/// (x2-facts), and the simulated client's 190 ms from L1's start is in that.
+const MARKER_AFTER_PROBE: f64 = 0.190;
+/// The quiet after the marker before phase 3.
+const QUIET_AFTER_MARKER: f64 = 0.075;
+/// From the marker to data mode: the script alone is some 6 s, and the
+/// server waits for the client's MP and E.
+const X2_DEADLINE: f64 = 30.0;
+/// Clean data mode at the first rate before asking for the fastest.
+const SETTLE: f64 = 2.0;
+/// The rate index a call starts at (32000, as a Courier's does) and the one
+/// it moves to on a line that carries octets exactly: 15, 56000.
+const FIRST_INDEX: u8 = 1;
+const FAST_INDEX: u8 = 15;
+/// Frames that would not read, in a second, that send the rate down.
+const TOO_MANY_BAD: usize = 40;
+
+#[derive(Debug, Clone)]
+enum Stage {
+    /// V.34's call modem, until INFO0a says whether the server offers x2.
+    Front,
+    /// The server offers x2: quiet from its L1 until the marker is due.
+    Quiet { probe_at: u64 },
+    /// The marker, then a moment's quiet.
+    Marker { tx: Box<dpsk::Transmitter>, quiet: u64 },
+    /// The x2 client, at the network's 8000 Hz.
+    X2,
+    /// No x2 on offer: V.34 to the end.
+    V34,
+    Failed(&'static str),
+}
+
+/// The x2 caller, one line sample at a time.
+#[derive(Debug, Clone)]
+pub struct Modem {
+    fs: f64,
+    now: u64,
+    stage: Stage,
+    v34: startup::Modem,
+    client: Client,
+    x2_since: u64,
+    /// Line rate to and from the network's.
+    down: Resampler,
+    up: Resampler,
+    arrived: Vec<f64>,
+    made: Vec<f64>,
+    out: VecDeque<f64>,
+    exact_in: VecDeque<f64>,
+    /// Whether exact levels have been given lately (a SIP line).
+    exact_seen: u64,
+    /// Data mode's own bookkeeping: since when, bad frames counted at the
+    /// last look, and when that was.
+    data_since: Option<u64>,
+    bad_at_look: usize,
+    look_at: u64,
+    asked_fast: bool,
+    /// Data mode has been reached: out of it again is a rate change.
+    reached_data: bool,
+    notes: Vec<String>,
+}
+
+/// Whether an INFO0a offers x2: an x2 server sends bit 23 alone of bits 21
+/// to 23 (`asymmetry` 4) and bit 24, CME (x2-facts, "Phase 2 marker"). A
+/// Courier takes either bit, but bit 23 is set in an ordinary V.34 answer
+/// modem's asymmetry of 5 as well, and the marker sent to one of those is
+/// a call lost; so here bit 23 counts only alone.
+pub fn offers_x2(info0: &Info0) -> bool {
+    info0.cme || info0.asymmetry == 4
+}
+
+impl Modem {
+    /// From the end of V.8, with `lead_in` of its handover silence to run.
+    pub fn new(fs: f64, lead_in: f64) -> Self {
+        let mut phase2 = crate::v34::phase2::Modem::new(Role::Call, fs);
+        phase2.set_lead_in(lead_in);
+        Self {
+            fs,
+            now: 0,
+            stage: Stage::Front,
+            v34: startup::Modem::with_phase2(phase2, fs),
+            client: Client::after_marker(),
+            x2_since: 0,
+            down: Resampler::new(fs, FS),
+            up: Resampler::new(FS, fs),
+            arrived: Vec::with_capacity(4),
+            made: Vec::with_capacity(8),
+            out: VecDeque::new(),
+            exact_in: VecDeque::new(),
+            exact_seen: 0,
+            data_since: None,
+            bad_at_look: 0,
+            look_at: 0,
+            asked_fast: false,
+            reached_data: false,
+            notes: Vec::new(),
+        }
+    }
+
+    /// What the network delivered, one level for every 8000 Hz sample, for
+    /// the samples [`Modem::step`] is about to be given: the server's octets
+    /// as they were sent. See `v90::server::Line::give_exact`.
+    pub fn give_exact(&mut self, levels: &[f64]) {
+        self.exact_in.extend(levels.iter().copied());
+        self.exact_seen = self.now;
+        while self.exact_in.len() > 4096 {
+            self.exact_in.pop_front();
+        }
+    }
+
+    /// What the start-up has to say, a line each, not yet taken.
+    pub fn take_notes(&mut self) -> Vec<String> {
+        std::mem::take(&mut self.notes)
+    }
+
+    pub fn is_x2(&self) -> bool {
+        matches!(self.stage, Stage::Marker { .. } | Stage::X2)
+    }
+
+    /// The V.34 start-up: the call's, before x2 takes it or when it does not.
+    pub fn v34(&self) -> &startup::Modem {
+        &self.v34
+    }
+
+    pub fn client(&self) -> &Client {
+        &self.client
+    }
+
+    fn secs(&self, s: f64) -> u64 {
+        (s * self.fs).round() as u64
+    }
+
+    /// One line sample in, one out.
+    pub fn step(&mut self, line: f64) -> f64 {
+        self.now += 1;
+        match &mut self.stage {
+            Stage::Front => {
+                let out = self.v34.step(line);
+                if let Some(info0) = self.v34.phase2().far_info0() {
+                    if offers_x2(&info0) {
+                        self.notes.push("x2: the server offers it".to_owned());
+                        self.stage = Stage::Quiet { probe_at: 0 };
+                    } else {
+                        self.notes.push("x2: the far end does not offer it; going on as V.34".to_owned());
+                        self.stage = Stage::V34;
+                    }
+                }
+                out
+            }
+            Stage::Quiet { probe_at } => {
+                // V.34 still listens, to hear the L1 begin, but says nothing:
+                // no L1, L2 or tone of its own.
+                let out = self.v34.step(line);
+                if *probe_at == 0 && self.v34.phase() == "V.34 reading the probe" {
+                    *probe_at = self.now;
+                }
+                if *probe_at == 0 {
+                    // Up to the server's L1 the caller is V.34's, INFO0a and
+                    // tone B included.
+                    return out;
+                }
+                if self.now >= *probe_at + (MARKER_AFTER_PROBE * self.fs) as u64 {
+                    let mut tx = dpsk::Transmitter::new(dpsk::Side::Call, self.fs);
+                    let mut bits = vec![true, true];
+                    // 4d: the PCM direction, the high carrier at 3200 baud,
+                    // as a Courier's.
+                    bits.extend(X2Marker::from_body(0x4d).to_bits());
+                    tx.send(&bits);
+                    tx.silence();
+                    self.notes.push("x2: sent the marker".to_owned());
+                    self.stage = Stage::Marker { tx: Box::new(tx), quiet: 0 };
+                }
+                0.0
+            }
+            Stage::Marker { tx, quiet } => {
+                if tx.is_sending() {
+                    return tx.next_sample();
+                }
+                *quiet += 1;
+                if (*quiet as f64) < QUIET_AFTER_MARKER * self.fs {
+                    return 0.0;
+                }
+                self.stage = Stage::X2;
+                self.x2_since = self.now;
+                self.out = VecDeque::from(vec![0.0; 4]);
+                0.0
+            }
+            Stage::X2 => self.x2_step(line),
+            Stage::V34 => self.v34.step(line),
+            Stage::Failed(_) => 0.0,
+        }
+    }
+
+    fn x2_step(&mut self, line: f64) -> f64 {
+        self.arrived.clear();
+        self.down.process(line, &mut self.arrived);
+        for i in 0..self.arrived.len() {
+            let level = self.exact_in.pop_front().unwrap_or(self.arrived[i]);
+            let sent = self.client.step(level);
+            self.made.clear();
+            self.up.process(sent, &mut self.made);
+            self.out.extend(self.made.iter().copied());
+        }
+        while self.out.len() > 64 {
+            self.out.pop_front();
+        }
+        self.watch();
+        self.out.pop_front().unwrap_or(0.0)
+    }
+
+    /// Deadlines, the far end going away, and the rate.
+    fn watch(&mut self) {
+        let in_data = self.client.in_data();
+        if !in_data && self.data_since.is_none() && self.now > self.x2_since + self.secs(X2_DEADLINE) {
+            let why = if self.now > self.exact_seen + self.secs(1.0) {
+                "x2: no data mode -- x2 needs a SIP line in PCMU, where the server's octets arrive as sent"
+            } else {
+                "x2: no data mode within 30 s of the marker"
+            };
+            self.notes.push(why.to_owned());
+            self.stage = Stage::Failed(why);
+            return;
+        }
+        if self.client.far_end_quiet() {
+            self.notes.push("x2: the server has gone quiet".to_owned());
+            self.stage = Stage::Failed("x2: the server has gone quiet");
+            return;
+        }
+        if !in_data {
+            return;
+        }
+        self.reached_data = true;
+        let since = *self.data_since.get_or_insert(self.now);
+        if since == self.now {
+            self.notes.push(format!(
+                "x2: data mode, {} down, {} up",
+                self.client.bank().rate(),
+                self.client.upstream_rate()
+            ));
+            self.look_at = self.now;
+            self.bad_at_look = self.client.bad_frames;
+        }
+        // Once a second: too many frames lost to the network sends the rate
+        // down a step at a time; a clean start sends it up to the top.
+        if self.now >= self.look_at + self.secs(1.0) {
+            let bad = self.client.bad_frames - self.bad_at_look;
+            self.look_at = self.now;
+            self.bad_at_look = self.client.bad_frames;
+            let index = self.client.index();
+            if bad > TOO_MANY_BAD && index > FIRST_INDEX {
+                let lower = index.saturating_sub(2).max(FIRST_INDEX);
+                self.notes.push(format!("x2: {bad} frames lost in a second; asking for index {lower}"));
+                self.change_rate(lower);
+            } else if !self.asked_fast && bad == 0 && self.now >= since + self.secs(SETTLE) {
+                self.asked_fast = true;
+                self.notes.push(format!("x2: the line is clean; asking for index {FAST_INDEX}"));
+                self.change_rate(FAST_INDEX);
+            }
+        }
+    }
+
+    fn change_rate(&mut self, index: u8) {
+        self.client.change_rate(index);
+        self.data_since = None;
+    }
+
+    pub fn status(&self) -> Status {
+        match &self.stage {
+            Stage::V34 => match self.v34.status() {
+                startup::Status::Running => Status::Running,
+                startup::Status::Connected { receive, transmit } => Status::Connected { receive, transmit },
+                startup::Status::Retraining => Status::Retraining,
+                startup::Status::ClearedDown | startup::Status::Done => Status::ClearedDown,
+                startup::Status::Failed(why) => Status::Failed(why),
+            },
+            Stage::Failed(why) => Status::Failed(why),
+            Stage::X2 if self.client.in_data() => Status::Connected {
+                receive: self.client.bank().rate(),
+                transmit: self.client.upstream_rate(),
+            },
+            // A rate change after data mode: as a retrain is.
+            Stage::X2 if self.reached_data => Status::Retraining,
+            _ => match self.v34.status() {
+                startup::Status::Failed(why) => Status::Failed(why),
+                _ => Status::Running,
+            },
+        }
+    }
+
+    pub fn phase(&self) -> &'static str {
+        match &self.stage {
+            Stage::Front => self.v34.phase(),
+            Stage::Quiet { .. } => "x2 waiting for the server's probe",
+            Stage::Marker { .. } => "x2 marker",
+            Stage::X2 if self.client.in_data() => "x2 data",
+            Stage::X2 => "x2 training",
+            Stage::V34 => self.v34.phase(),
+            Stage::Failed(_) => "x2 failed",
+        }
+    }
+
+    pub fn carrier(&self) -> bool {
+        match &self.stage {
+            Stage::X2 => !self.client.far_end_quiet(),
+            Stage::V34 | Stage::Front => self.v34.carrier(),
+            _ => true,
+        }
+    }
+
+    pub fn take_bits(&mut self) -> Vec<bool> {
+        match &self.stage {
+            Stage::X2 => self.client.take_bits(),
+            Stage::V34 => self.v34.take_bits(),
+            _ => Vec::new(),
+        }
+    }
+
+    pub fn send_bits(&mut self, bits: &[bool]) {
+        match &self.stage {
+            Stage::V34 => self.v34.send_bits(bits),
+            _ => self.client.send_bits(bits),
+        }
+    }
+
+    pub fn accepts_bits(&self) -> bool {
+        match &self.stage {
+            Stage::V34 => self.v34.accepts_bits(),
+            Stage::X2 => self.client.in_data(),
+            _ => false,
+        }
+    }
+
+    /// How many bits it wants queued (see [`Client::fill_bits`]).
+    pub fn fill_bits(&self) -> usize {
+        match &self.stage {
+            Stage::V34 => 64,
+            _ => self.client.fill_bits(),
+        }
+    }
+
+    pub fn pending_bits(&self) -> usize {
+        match &self.stage {
+            Stage::V34 => self.v34.pending_bits(),
+            _ => self.client.pending_bits(),
+        }
+    }
+
+    pub fn round_trip(&self) -> Option<f64> {
+        self.v34.phase2().round_trip()
+    }
+}
