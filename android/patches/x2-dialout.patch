diff --git a/crates/modem/tests/x2_pair.rs b/crates/modem/tests/x2_pair.rs
new file mode 100644
index 0000000..6f9fdda
--- /dev/null
+++ b/crates/modem/tests/x2_pair.rs
@@ -0,0 +1,63 @@
+//! Two of these with `AT+MS=X2`, one dialling and one answering, wired to
+//! each other at 16 kHz with the host's G.711 levels handed to the caller,
+//! as a SIP line does: V.8, phase 2 with the x2 marker, x2's training and
+//! data, the move to 56000, and both ends online with V.42 over it.
+
+use std::collections::VecDeque;
+
+use modem::{Modem, State};
+
+const FS: f64 = 16_000.0;
+
+fn type_at(modem: &mut Modem, line: &str) {
+    for b in line.bytes() {
+        modem.feed_dte(b);
+    }
+    modem.feed_dte(b'\r');
+}
+
+#[test]
+fn two_of_these_connect_on_x2_with_error_control() {
+    let mut caller = Modem::new(FS);
+    let mut host = Modem::new(FS);
+    let mut to_host: VecDeque<f64> = vec![0.0; 320].into();
+    let mut to_caller: VecDeque<f64> = vec![0.0; 320].into();
+    let mut levels_to_caller: VecDeque<f64> = vec![0.0; 160].into();
+    let (mut caller_said, mut host_said) = (Vec::new(), Vec::new());
+    type_at(&mut host, "AT+MS=X2;A");
+    type_at(&mut caller, "AT+MS=X2;D5551234");
+    let mut log = String::new();
+    let mut up = false;
+    for second in 0..60 {
+        for _ in 0..(FS as usize / 2) {
+            // Two line samples to one network level.
+            let mut levels = Vec::new();
+            for _ in 0..2 {
+                let heard = to_caller.pop_front().unwrap_or(0.0);
+                to_host.push_back(caller.step(heard));
+                let heard = to_host.pop_front().unwrap_or(0.0);
+                to_caller.push_back(host.step(heard));
+            }
+            if let Some(l) = host.take_network_levels() {
+                levels.extend(l);
+            }
+            levels_to_caller.extend(levels);
+            let give: Vec<f64> = (0..1).filter_map(|_| levels_to_caller.pop_front()).collect();
+            caller.give_network_levels(&give);
+            caller_said.extend(caller.take_dte());
+            host_said.extend(host.take_dte());
+        }
+        for (who, m) in [("caller", &mut caller), ("host", &mut host)] {
+            for n in m.take_line_notes() {
+                log.push_str(&format!("{who}: {n}\n"));
+            }
+        }
+        log.push_str(&format!("{:.1}s caller {:?} {} | host {:?} {}\n", second as f64 / 2.0, caller.state(), caller.line_phase(), host.state(), host.line_phase()));
+        if caller.state() == State::Data && host.state() == State::Data && caller.rate().is_some_and(|r| r > 32_000) {
+            up = true;
+            break;
+        }
+    }
+    assert!(up, "{log}");
+    assert_eq!(caller.standard(), "x2", "{log}");
+}
diff --git a/crates/modem/tests/x2_sip.rs b/crates/modem/tests/x2_sip.rs
new file mode 100644
index 0000000..b2f615e
--- /dev/null
+++ b/crates/modem/tests/x2_sip.rs
@@ -0,0 +1,212 @@
+//! An x2 call between two of these over SIP media on this machine: the
+//! caller `AT+MS=X2` dialling out as an x2 client, the host `AT+MS=X2`
+//! answering as an x2 server, PCMU in 20 ms packets with 0-30 ms of jitter
+//! on the way down -- and, once both are online, a packet lost every two
+//! seconds, which moves the client's frames and has to be found again.
+//!
+//! Both ends are this program, written from the same facts (libv90modem's
+//! x2-facts), so it shows they agree with each other over a real media path,
+//! not that either is x2: only a U.S. Robotics modem can show that.
+//!
+//! ```text
+//! cargo test --release -p modem --test x2_sip
+//! ```
+
+use std::collections::VecDeque;
+use std::net::{SocketAddr, UdpSocket};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use modem::{Modem, State};
+use sip::g711::{self, Law};
+use sip::media::Media;
+
+const FS: f64 = 16_000.0;
+const DRIVE: f32 = 0.1;
+
+fn local(port: u16) -> SocketAddr {
+    SocketAddr::from(([127, 0, 0, 1], port))
+}
+
+#[derive(Default, Clone)]
+struct Seen {
+    online: bool,
+    standard: String,
+    rate: Option<u32>,
+}
+
+struct End {
+    terminal: Vec<u8>,
+    notes: Vec<String>,
+}
+
+/// A modem stepped the way the window steps one on a SIP line.
+fn run_modem(media: Media, commands: &'static str, typed: Arc<Mutex<VecDeque<u8>>>, seen: Arc<Mutex<Seen>>, stop: Arc<AtomicBool>) -> End {
+    let mut modem = Modem::new(FS);
+    for b in commands.bytes() {
+        modem.feed_dte(b);
+    }
+    modem.feed_dte(b'\r');
+    let mut end = End { terminal: Vec::new(), notes: Vec::new() };
+    let (mut from_line, mut from_network, mut to_line) = (Vec::new(), Vec::new(), Vec::new());
+    while !stop.load(Ordering::Relaxed) {
+        if let Ok(mut typed) = typed.lock() {
+            for b in typed.drain(..) {
+                modem.feed_dte(b);
+            }
+        }
+        from_line.clear();
+        from_network.clear();
+        media.receive_both(&mut from_line, Some(&mut from_network));
+        if from_line.is_empty() {
+            thread::sleep(Duration::from_millis(2));
+            continue;
+        }
+        let levels: Vec<f64> = from_network.iter().map(|l| f64::from(*l)).collect();
+        modem.give_network_levels(&levels);
+        to_line.clear();
+        for &s in &from_line {
+            let said = modem.step(f64::from(s)) as f32;
+            let drive = if modem.exact_levels() { 1.0 } else { DRIVE };
+            to_line.push(said * drive);
+        }
+        match modem.take_network_levels() {
+            Some(levels) => {
+                let levels: Vec<f32> = levels.iter().map(|l| *l as f32).collect();
+                media.transmit_exact(&levels);
+            }
+            None => media.transmit(&to_line),
+        }
+        end.terminal.extend(modem.take_dte());
+        end.notes.extend(modem.take_line_notes());
+        if let Ok(mut seen) = seen.lock() {
+            seen.online = modem.state() == State::Data;
+            seen.standard = modem.standard().to_owned();
+            seen.rate = modem.rate();
+        }
+    }
+    end
+}
+
+#[test]
+#[cfg_attr(debug_assertions, ignore = "two modems in real time: run it with --release")]
+fn an_x2_call_over_sip_media_comes_up_and_carries_text_through_lost_packets() {
+    let facing_caller = UdpSocket::bind("127.0.0.1:0").unwrap();
+    let facing_host = UdpSocket::bind("127.0.0.1:0").unwrap();
+    facing_caller.set_read_timeout(Some(Duration::from_millis(1))).unwrap();
+    facing_host.set_read_timeout(Some(Duration::from_millis(1))).unwrap();
+    let caller_media = Media::open(0, FS).unwrap();
+    let host_media = Media::open(0, FS).unwrap();
+    let (caller_port, host_port) = (caller_media.local_port(), host_media.local_port());
+    caller_media.connect(facing_caller.local_addr().unwrap(), Law::Mu, g711::PCMU, 20);
+    host_media.connect(facing_host.local_addr().unwrap(), Law::Mu, g711::PCMU, 20);
+
+    let stop = Arc::new(AtomicBool::new(false));
+    let lossy = Arc::new(AtomicBool::new(false));
+
+    let upstream = {
+        let (from, to, stop) = (facing_caller.try_clone().unwrap(), facing_host.try_clone().unwrap(), Arc::clone(&stop));
+        thread::spawn(move || {
+            let mut buffer = [0u8; 2048];
+            while !stop.load(Ordering::Relaxed) {
+                if let Ok(n) = from.recv(&mut buffer) {
+                    let _ = to.send_to(&buffer[..n], local(host_port));
+                }
+            }
+        })
+    };
+    // Host to caller: 0-30 ms of jitter, in order; once `lossy`, one packet
+    // in every hundred lost.
+    let downstream = {
+        let (from, to, stop, lossy) = (facing_host.try_clone().unwrap(), facing_caller.try_clone().unwrap(), Arc::clone(&stop), Arc::clone(&lossy));
+        thread::spawn(move || {
+            let mut held: VecDeque<(Instant, Vec<u8>)> = VecDeque::new();
+            let mut buffer = [0u8; 2048];
+            let mut state = 4_242u32;
+            let mut random = move || {
+                state = state.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+                state >> 8
+            };
+            let (mut count, mut lost) = (0u32, 0u32);
+            let mut last = Instant::now();
+            while !stop.load(Ordering::Relaxed) {
+                let now = Instant::now();
+                if let Ok(n) = from.recv(&mut buffer) {
+                    count += 1;
+                    if lossy.load(Ordering::Relaxed) && count % 100 == 0 {
+                        lost += 1;
+                    } else {
+                        let at = (now + Duration::from_millis(u64::from(random() % 31))).max(last);
+                        last = at;
+                        held.push_back((at, buffer[..n].to_vec()));
+                    }
+                }
+                while held.front().is_some_and(|h| h.0 <= now) {
+                    let (_, d) = held.pop_front().unwrap();
+                    let _ = to.send_to(&d, local(caller_port));
+                }
+            }
+            lost
+        })
+    };
+
+    let caller_typed = Arc::new(Mutex::new(VecDeque::new()));
+    let host_typed = Arc::new(Mutex::new(VecDeque::new()));
+    let (caller_seen, host_seen) = (Arc::new(Mutex::new(Seen::default())), Arc::new(Mutex::new(Seen::default())));
+    let host = {
+        let (stop, seen, typed) = (Arc::clone(&stop), Arc::clone(&host_seen), Arc::clone(&host_typed));
+        thread::spawn(move || run_modem(host_media, "AT+MS=X2;A", typed, seen, stop))
+    };
+    let caller = {
+        let (stop, seen, typed) = (Arc::clone(&stop), Arc::clone(&caller_seen), Arc::clone(&caller_typed));
+        thread::spawn(move || run_modem(caller_media, "AT+MS=X2;D5551234", typed, seen, stop))
+    };
+
+    // Online, then up to the fast rate.
+    let deadline = Instant::now() + Duration::from_secs(45);
+    let fast = || {
+        let c = caller_seen.lock().unwrap().clone();
+        c.online && host_seen.lock().unwrap().online && c.rate.is_some_and(|r| r > 32_000)
+    };
+    while !fast() && Instant::now() < deadline {
+        thread::sleep(Duration::from_millis(100));
+    }
+    let at_fast = caller_seen.lock().unwrap().clone();
+    let mut sent = (String::new(), String::new());
+    if fast() {
+        thread::sleep(Duration::from_secs(2));
+        lossy.store(true, Ordering::Relaxed);
+        for line in 0..60 {
+            let down = format!("down {line:03}: the quick brown fox jumps over the lazy dog\r\n");
+            let up = format!("up {line:03}: pack my box with five dozen liquor jugs\r\n");
+            host_typed.lock().unwrap().extend(down.bytes());
+            caller_typed.lock().unwrap().extend(up.bytes());
+            sent.0.push_str(&down);
+            sent.1.push_str(&up);
+            thread::sleep(Duration::from_millis(150));
+        }
+        thread::sleep(Duration::from_secs(5));
+    }
+    stop.store(true, Ordering::Relaxed);
+    let (caller, host) = (caller.join().unwrap(), host.join().unwrap());
+    upstream.join().unwrap();
+    let lost = downstream.join().unwrap();
+    let saw = |end: &End| String::from_utf8_lossy(&end.terminal).into_owned();
+    let notes = |end: &End| end.notes.join("\n");
+    assert!(
+        at_fast.online,
+        "the call never came up fast\ncaller: {:?}\n{}\nhost: {:?}\n{}",
+        saw(&caller),
+        notes(&caller),
+        saw(&host),
+        notes(&host)
+    );
+    assert_eq!(at_fast.standard, "x2", "{}", notes(&caller));
+    assert!(lost >= 5, "only {lost} packets were lost");
+    let (got_down, got_up) = (saw(&caller), saw(&host));
+    assert!(got_down.contains(&sent.0), "the caller did not get the host's text\n{got_down:?}\n{}", notes(&caller));
+    assert!(got_up.contains(&sent.1), "the host did not get the caller's text\n{got_up:?}\n{}", notes(&host));
+    eprintln!("x2 at {:?} bit/s down; {lost} packets lost on the way down\n{}", at_fast.rate, notes(&caller));
+}
