+//! V.92's PCM upstream transmitter (6.4/V.92), and its inverse.
+//!
+//! ```text
+//!   bits -> modulus encoder -> K0..K11 -> precoder -> x(n) -> prefilter -> G v(n)
+//!                                            ^  | y(n)
+//!                     convolutional encoder Y0  inverse map  <-+
+//! ```
+//!
+//! A data frame is twelve symbols at 8000 a second. Its K scrambled bits
+//! become twelve numbers, one per symbol, each less than that interval's
+//! modulus Mi (6.4.1). Each number names an equivalence class of points of
+//! that interval's constellation -- every point whose index is the number
+//! plus a multiple of Mi, or for the last symbol of each four, twice that
+//! with its parity set by the trellis code -- and the precoder picks from it
+//! the point that keeps its own output smallest (6.4.2, and the Note to
+//! 8.8.3: the digital modem designs "under the assumption that the analogue
+//! modem minimizes the power at the precoder output on a symbol-by-symbol
+//! basis"). The precoder's filters cancel what the line will do, so the
+//! codec at the far end sees the chosen point itself; the digital modem
+//! slices it, and the class it is in gives back the number.
+//!
+//! Everything the transmitter needs comes from the digital modem in CPd
+//! (Table 30/V.92): the moduli, the four filters, the gain, the
+//! constellations and the trellis code. [`Decoder`] is the digital modem's
+//! side of the same, for a server to be tested against.
+
+use crate::v34::trellis::{self, Code};
+
+/// Symbols in an upstream data frame (Figure 1/V.92).
+pub const FRAME: usize = 12;
+
+/// Symbols in a trellis frame.
+pub const TRELLIS: usize = 4;
+
+/// One constellation as CPd gives it (Table 30/V.92): its positive points,
+/// smallest first, in the codec's linear units. The negative points are
+/// their negatives; there is no zero point.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Constellation {
+    pub positive: Vec<f64>,
+}
+
+impl Constellation {
+    /// N, the number of points.
+    pub fn len(&self) -> i64 {
+        2 * self.positive.len() as i64
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.positive.is_empty()
+    }
+
+    /// a(eta), for -N/2 <= eta < N/2: "negative points have negative
+    /// indices, and positive points have non-negative indices".
+    pub fn point(&self, eta: i64) -> f64 {
+        if eta >= 0 {
+            self.positive[eta as usize]
+        } else {
+            -self.positive[(-eta - 1) as usize]
+        }
+    }
+
+    /// The index of the point nearest `value`.
+    pub fn nearest(&self, value: f64) -> i64 {
+        let magnitude = value.abs();
+        let i = self
+            .positive
+            .iter()
+            .enumerate()
+            .min_by(|a, b| (a.1 - magnitude).abs().total_cmp(&(b.1 - magnitude).abs()))
+            .map_or(0, |(i, _)| i as i64);
+        if value >= 0.0 { i } else { -i - 1 }
+    }
+}
+
+/// What CPd sets the transmitter up with.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Params {
+    /// K, bits per data frame: (drn + 17) * 8000/6 bit/s is 2 (drn + 17)
+    /// bits a frame of 12 symbols.
+    pub bits: usize,
+    /// M0 to M11.
+    pub moduli: [u32; FRAME],
+    /// The constellation each data frame interval uses (an interval and the
+    /// one six after it share one, Table 30).
+    pub constellations: [Constellation; FRAME],
+    /// z1(1..=LZ1), p1(1..=LP1), z2(0..LZ2), p2(1..=LP2).
+    pub z1: Vec<f64>,
+    pub p1: Vec<f64>,
+    pub z2: Vec<f64>,
+    pub p2: Vec<f64>,
+    /// G, the gain after the prefilter.
+    pub gain: f64,
+    pub code: Code,
+}
+
+impl Params {
+    /// The data signalling rate in bit/s.
+    pub fn rate(&self) -> u32 {
+        (self.bits as u32 * 8000) / FRAME as u32
+    }
+
+    /// The product of the moduli, which 6.4.1 requires to be at least 2^K.
+    pub fn product(&self) -> u128 {
+        self.moduli.iter().map(|&m| u128::from(m)).product()
+    }
+
+    /// Whether these can carry K bits at all.
+    pub fn valid(&self) -> bool {
+        self.bits <= 127
+            && self.moduli.iter().all(|&m| m >= 1)
+            && self.product() >= 1u128 << self.bits
+            && self.constellations.iter().enumerate().all(|(i, c)| {
+                let k = i % TRELLIS;
+                let needed = if k == 3 { 2 * self.moduli[i] } else { self.moduli[i] };
+                c.len() >= i64::from(needed)
+            })
+    }
+}
+
+/// 6.4.1: K bits to twelve numbers, with the sign of R differentially
+/// encoded from frame to frame.
+#[derive(Debug, Clone, Default)]
+pub struct ModulusEncoder {
+    /// d(f - 1).
+    previous: bool,
+}
+
+impl ModulusEncoder {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn reset(&mut self) {
+        self.previous = false;
+    }
+
+    /// `bits`, b0 first in time, as K0 to K11.
+    pub fn encode(&mut self, bits: &[bool], moduli: &[u32; FRAME]) -> [u32; FRAME] {
+        let m: u128 = moduli.iter().map(|&m| u128::from(m)).product();
+        // 1) R = b0 + b1 2 + ... + b(K-1) 2^(K-1).
+        let r = bits.iter().enumerate().fold(0u128, |r, (i, &b)| r | u128::from(b) << i);
+        // 2) and 3): the 'sign', differentially encoded.
+        let s = r > (m - 1) / 2;
+        let d = s ^ self.previous;
+        // 4) R0 = R, or its mirror, by d(f - 1).
+        let mut ri = if self.previous { m - 1 - r } else { r };
+        self.previous = d;
+        // 5) Mixed-radix digits, interval 0 first.
+        let mut k = [0u32; FRAME];
+        for (slot, &mi) in k.iter_mut().zip(moduli) {
+            let mi = u128::from(mi);
+            *slot = (ri % mi) as u32;
+            ri /= mi;
+        }
+        k
+    }
+}
+
+/// 6.4.1 backwards, at the digital modem.
+#[derive(Debug, Clone, Default)]
+pub struct ModulusDecoder {
+    previous: bool,
+}
+
+impl ModulusDecoder {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn reset(&mut self) {
+        self.previous = false;
+    }
+
+    /// K0 to K11 back to `bits` bits, b0 first.
+    pub fn decode(&mut self, k: &[u32; FRAME], moduli: &[u32; FRAME], bits: usize) -> Vec<bool> {
+        let m: u128 = moduli.iter().map(|&m| u128::from(m)).product();
+        let mut r0 = 0u128;
+        for (&ki, &mi) in k.iter().zip(moduli).rev() {
+            r0 = r0 * u128::from(mi) + u128::from(ki);
+        }
+        let r = if self.previous { (m - 1).saturating_sub(r0) } else { r0 };
+        let s = r > (m - 1) / 2;
+        self.previous = s ^ self.previous;
+        (0..bits).map(|i| r >> i & 1 == 1).collect()
+    }
+}
+
+/// The trellis code across a data frame: Y0 for the last symbol of each four,
+/// and the next state from the inverse map of all four (6.4.3, 6.4.4).
+#[derive(Debug, Clone, Default)]
+pub struct Trellis {
+    code: Code,
+    state: u8,
+}
+
+impl Trellis {
+    pub fn new(code: Code) -> Self {
+        Self { code, state: 0 }
+    }
+
+    pub fn reset(&mut self) {
+        self.state = 0;
+    }
+
+    /// Y0, from the state the trellis frame begins in.
+    pub fn y0(&self) -> bool {
+        self.code.output(self.state)
+    }
+
+    /// The trellis frame's four indices sent: the inverse map takes
+    /// (y(0), y(1)) and (y(2), y(3)) as two-dimensional points with odd
+    /// coordinates 2y + 1, and V.34's symbol-to-bit converter makes Y1 to Y4
+    /// of them; with "the 2T delays ... replaced by 4T delays" the encoder
+    /// steps once a trellis frame.
+    pub fn advance(&mut self, y: [i64; TRELLIS]) {
+        let odd = |v: i64| (2 * v + 1) as i32;
+        let first = trellis::label((odd(y[0]), odd(y[1])));
+        let second = trellis::label((odd(y[2]), odd(y[3])));
+        let bits = trellis::convert(first, second);
+        self.state = self.code.next(self.state, bits & self.code.inputs());
+    }
+}
+
+/// The parity the last point of a trellis frame has to make up: eta3 is
+/// "2Ki + 2 zk Mi + (eta0 + eta1 + eta2 + Y0) mod 2".
+fn parity(first_three: &[i64], y0: bool) -> i64 {
+    (first_three.iter().sum::<i64>() + i64::from(y0)).rem_euclid(2)
+}
+
+/// The precoder and prefilter (6.4.2): filter state, and the choice of point.
+#[derive(Debug, Clone)]
+pub struct Precoder {
+    /// u(n - 1), u(n - 2), ... and x(n - 1), ..., and v(n - 1), ...
+    u: Vec<f64>,
+    x: Vec<f64>,
+    v: Vec<f64>,
+}
+
+impl Precoder {
+    pub fn new(params: &Params) -> Self {
+        Self {
+            u: vec![0.0; params.z1.len()],
+            x: vec![0.0; params.p1.len().max(params.z2.len())],
+            v: vec![0.0; params.p2.len()],
+        }
+    }
+
+    /// The precoder filter's output for a point `u`, before it is kept.
+    fn x_for(&self, params: &Params, u: f64) -> f64 {
+        let ff: f64 = params.z1.iter().zip(&self.u).map(|(z, u)| z * u).sum();
+        let fb: f64 = params.p1.iter().zip(&self.x).map(|(p, x)| p * x).sum();
+        u + ff + fb
+    }
+
+    /// Choose from the class of points `candidate(z)`, z an integer, the
+    /// one whose precoder output is smallest; keep it; return its index and
+    /// G v(n).
+    fn send(&mut self, params: &Params, constellation: &Constellation, candidates: impl Iterator<Item = i64>) -> (i64, f64) {
+        let (eta, u, x) = candidates
+            .map(|eta| {
+                let u = constellation.point(eta);
+                (eta, u, self.x_for(params, u))
+            })
+            .min_by(|a, b| a.2.abs().total_cmp(&b.2.abs()))
+            .expect("a class is never empty in valid parameters");
+        if !self.u.is_empty() {
+            self.u.rotate_right(1);
+            self.u[0] = u;
+        }
+        if !self.x.is_empty() {
+            self.x.rotate_right(1);
+            self.x[0] = x;
+        }
+        // v(n) = sum z2(k) x(n - k), k from 0, + sum p2(k) v(n - k).
+        let ff: f64 = params.z2.iter().zip(&self.x).map(|(z, x)| z * x).sum();
+        let fb: f64 = params.p2.iter().zip(&self.v).map(|(p, v)| p * v).sum();
+        let v = ff + fb;
+        if !self.v.is_empty() {
+            self.v.rotate_right(1);
+            self.v[0] = v;
+        }
+        (eta, params.gain * v)
+    }
+}
+
+/// The whole transmitter, from scrambled bits to G v(n).
+#[derive(Debug, Clone)]
+pub struct Transmitter {
+    params: Params,
+    modulus: ModulusEncoder,
+    trellis: Trellis,
+    precoder: Precoder,
+}
+
+impl Transmitter {
+    /// "The scrambler, modulus encoder, convolutional encoder, precoder and
+    /// prefilter memories are initialized to zero prior to transmitting B1u"
+    /// (8.7.1/V.92).
+    pub fn new(params: Params) -> Self {
+        let precoder = Precoder::new(&params);
+        let trellis = Trellis::new(params.code);
+        Self { params, modulus: ModulusEncoder::new(), trellis, precoder }
+    }
+
+    pub fn params(&self) -> &Params {
+        &self.params
+    }
+
+    /// One data frame: K bits in, twelve line levels out.
+    pub fn frame(&mut self, bits: &[bool]) -> [f64; FRAME] {
+        let k = self.modulus.encode(bits, &self.params.moduli);
+        self.send_numbers(&k)
+    }
+
+    /// Twelve modulus numbers as they are (RM and RM', Tables 25 and 26).
+    pub fn send_numbers(&mut self, k: &[u32; FRAME]) -> [f64; FRAME] {
+        let mut out = [0.0; FRAME];
+        let mut etas = [0i64; TRELLIS];
+        for i in 0..FRAME {
+            let slot = i % TRELLIS;
+            let m = i64::from(self.params.moduli[i]);
+            let ki = i64::from(k[i]);
+            let constellation = self.params.constellations[i].clone();
+            let half = constellation.len() / 2;
+            let (eta, level) = if slot == 3 {
+                let p = parity(&etas[..3], self.trellis.y0());
+                let first = 2 * ki + p;
+                let candidates = class(first, 2 * m, half);
+                self.precoder.send(&self.params, &constellation, candidates)
+            } else {
+                self.precoder.send(&self.params, &constellation, class(ki, m, half))
+            };
+            etas[slot] = eta;
+            out[i] = level;
+            if slot == 3 {
+                self.trellis.advance(etas);
+            }
+        }
+        out
+    }
+}
+
+/// Every eta in -half..half that is `first` plus a multiple of `step`.
+fn class(first: i64, step: i64, half: i64) -> impl Iterator<Item = i64> {
+    let start = first - step * ((first + half).div_euclid(step));
+    (0..).map(move |z| start + z * step).take_while(move |&eta| eta < half).filter(move |&eta| eta >= -half)
+}
+
+/// The digital modem's side: the points that arrived, back to bits. Hard
+/// decisions, the trellis followed on what was decided.
+#[derive(Debug, Clone)]
+pub struct Decoder {
+    params: Params,
+    modulus: ModulusDecoder,
+    trellis: Trellis,
+}
+
+impl Decoder {
+    pub fn new(params: Params) -> Self {
+        let trellis = Trellis::new(params.code);
+        Self { params, modulus: ModulusDecoder::new(), trellis }
+    }
+
+    /// The indices of a data frame's twelve points, as the codec delivered
+    /// them and the slicer read them, back to the modulus numbers.
+    pub fn numbers(&mut self, etas: &[i64; FRAME]) -> [u32; FRAME] {
+        let mut k = [0u32; FRAME];
+        for t in 0..FRAME / TRELLIS {
+            let frame = &etas[t * TRELLIS..(t + 1) * TRELLIS];
+            for (slot, &eta) in frame.iter().enumerate() {
+                let i = t * TRELLIS + slot;
+                let m = i64::from(self.params.moduli[i]);
+                k[i] = if slot == 3 {
+                    let p = parity(&frame[..3], self.trellis.y0());
+                    ((eta - p).div_euclid(2)).rem_euclid(m) as u32
+                } else {
+                    eta.rem_euclid(m) as u32
+                };
+            }
+            self.trellis.advance([frame[0], frame[1], frame[2], frame[3]]);
+        }
+        k
+    }
+
+    /// The same, to bits.
+    pub fn frame(&mut self, etas: &[i64; FRAME]) -> Vec<bool> {
+        let k = self.numbers(etas);
+        self.modulus.decode(&k, &self.params.moduli, self.params.bits)
+    }
+
+    /// Slice line levels, already divided by the gain and freed of the
+    /// line's own filtering, to indices.
+    pub fn slice(&self, levels: &[f64; FRAME]) -> [i64; FRAME] {
+        std::array::from_fn(|i| self.params.constellations[i].nearest(levels[i]))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A plain constellation: `n` positive points evenly spaced.
+    fn ladder(n: usize, step: f64) -> Constellation {
+        Constellation { positive: (0..n).map(|i| step * (i as f64 + 0.5)).collect() }
+    }
+
+    fn params(bits: usize, moduli: [u32; FRAME], points: usize) -> Params {
+        Params {
+            bits,
+            moduli,
+            constellations: std::array::from_fn(|_| ladder(points, 100.0)),
+            z1: Vec::new(),
+            p1: Vec::new(),
+            z2: vec![1.0],
+            p2: Vec::new(),
+            gain: 1.0,
+            code: Code::States16,
+        }
+    }
+
+    fn bits(seed: u64, n: usize) -> Vec<bool> {
+        let mut x = seed | 1;
+        (0..n)
+            .map(|_| {
+                x ^= x << 13;
+                x ^= x >> 7;
+                x ^= x << 17;
+                x & 1 == 1
+            })
+            .collect()
+    }
+
+    #[test]
+    fn the_modulus_encoder_and_decoder_are_inverses_across_frames() {
+        let moduli = [9, 8, 9, 8, 9, 8, 9, 8, 9, 8, 9, 8];
+        let k = 36;
+        let mut enc = ModulusEncoder::new();
+        let mut dec = ModulusDecoder::new();
+        for f in 0..200 {
+            let b = bits(f + 7, k);
+            let numbers = enc.encode(&b, &moduli);
+            assert!(numbers.iter().zip(&moduli).all(|(k, m)| k < m));
+            assert_eq!(dec.decode(&numbers, &moduli, k), b, "frame {f}");
+        }
+    }
+
+    #[test]
+    fn every_class_is_the_number_and_its_steps() {
+        let c: Vec<i64> = class(3, 8, 16).collect();
+        assert_eq!(c, vec![-13, -5, 3, 11]);
+        assert!(class(0, 1, 4).eq(-4..4));
+    }
+
+    /// Through a line that does nothing, with no precoding: every frame
+    /// comes back as it went, trellis and all, at 48 000 bit/s.
+    #[test]
+    fn a_clean_line_carries_every_frame_at_48000() {
+        // 72 bits a frame: twelve moduli whose product passes 2^72 -- 64 for
+        // the first three of each four, and 64 pairs for the fourth.
+        let p = params(72, [64; FRAME], 128);
+        assert!(p.valid());
+        assert_eq!(p.rate(), 48_000);
+        let mut tx = Transmitter::new(p.clone());
+        let mut rx = Decoder::new(p);
+        for f in 0..300 {
+            let b = bits(f + 1, 72);
+            let levels = tx.frame(&b);
+            let etas = rx.slice(&levels);
+            assert_eq!(rx.frame(&etas), b, "frame {f}");
+        }
+    }
+
+    /// With a precoder that cancels a line's echo of the last symbol, the
+    /// codec sees the points themselves, and the transmitter keeps its own
+    /// output small by choosing among each class.
+    #[test]
+    fn a_precoder_undoes_the_line_it_was_designed_for() {
+        let mut p = params(48, [16; FRAME], 64);
+        // The line: r(n) = s(n) + 0.5 s(n - 1). The precoder: x(n) = u(n) -
+        // 0.5 x(n - 1), so r(n) = u(n).
+        p.p1 = vec![-0.5];
+        assert!(p.valid());
+        let mut tx = Transmitter::new(p.clone());
+        let mut rx = Decoder::new(p);
+        let mut last = 0.0;
+        let mut peak: f64 = 0.0;
+        for f in 0..300 {
+            let b = bits(f + 11, 48);
+            let sent = tx.frame(&b);
+            let mut arrived = [0.0; FRAME];
+            for (a, &s) in arrived.iter_mut().zip(&sent) {
+                *a = s + 0.5 * last;
+                last = s;
+                peak = peak.max(s.abs());
+            }
+            let etas = rx.slice(&arrived);
+            assert_eq!(rx.frame(&etas), b, "frame {f}");
+        }
+        // The points reach 6400; the choice keeps what is sent within reach.
+        assert!(peak < 6400.0, "peak {peak}");
+    }
+}
