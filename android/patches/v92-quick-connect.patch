+//! V.92's PCM upstream: what the analogue modem sends when the digital
+//! modem receives PCM from it (6.4, 8.5 to 8.8 and 9.5 to 9.6/V.92).
+
+pub mod transmitter;
+pub mod sequences;
+pub mod line;
+pub mod receiver;
+pub mod finder;
