diff --git a/crates/datapump/tests/v92_quick.rs b/crates/datapump/tests/v92_quick.rs
new file mode 100644
index 0000000..2d7314c
--- /dev/null
+++ b/crates/datapump/tests/v92_quick.rs
@@ -0,0 +1,217 @@
+//! V.92's short Phase 2 (9.4/V.92) between the two modems here: a full
+//! start-up with a V.92 server first, which is what the analogue modem
+//! learns the upstream from, then a start-up asking for the short Phase 2
+//! with what it learned.
+
+use datapump::v34::info::{Info0, Info0d};
+use datapump::v34::phase2::Recall;
+use datapump::v90::network::Network;
+use datapump::v90::startup::{Analogue, Digital, Status};
+use datapump::v90::ucode::Law;
+
+const FS: f64 = 16_000.0;
+
+/// A V.92 server: V.90's test server, saying V.92 and offering the short
+/// Phase 2 in INFO0d.
+fn v92_server() -> Info0d {
+    Info0d {
+        v34: Info0 { constellation_1664: true, rate_3429: true, ..Info0::default() },
+        nominal_power: 4,
+        max_power: 23,
+        power_at_codec: true,
+        a_law: false,
+        upstream_3429: false,
+        v92: true,
+        short_phase2: true,
+    }
+}
+
+fn line() -> Network {
+    Network::new(Law::Mu, FS).with_delay(0.020, FS).with_noise(1e-5)
+}
+
+/// Run until both ends are in data mode, and say how long it took in
+/// seconds, or None if either failed or `limit` ran out.
+fn run(analogue: &mut Analogue, digital: &mut Digital, mut net: Network, limit: f64) -> Option<f64> {
+    run_on(analogue, digital, &mut net, &mut Vec::new(), limit)
+}
+
+/// The same on a network and with the analogue modem's samples not yet sent
+/// up kept by the caller, so that a test can go on from where this stops.
+fn run_on(analogue: &mut Analogue, digital: &mut Digital, net: &mut Network, up: &mut Vec<f64>, limit: f64) -> Option<f64> {
+    let mut ticks = 0u64;
+    let mut last = (String::new(), String::new());
+    while (ticks as f64) < limit * 8000.0 {
+        let to_digital = net.up(up);
+        up.clear();
+        let from_digital = digital.step(to_digital);
+        for x in net.down(from_digital) {
+            up.push(analogue.step(x));
+        }
+        ticks += 1;
+        let now = (analogue.phase().to_owned(), digital.phase().to_owned());
+        if now != last {
+            println!("{:7.3} s  analogue: {:36} digital: {}", ticks as f64 / 8000.0, now.0, now.1);
+            last = now;
+        }
+        let connected = |s: Status| matches!(s, Status::Connected { .. });
+        if connected(analogue.status()) && connected(digital.status()) {
+            return Some(ticks as f64 / 8000.0);
+        }
+        if matches!(analogue.status(), Status::Failed(_)) || matches!(digital.status(), Status::Failed(_)) {
+            println!("failed: {:?} / {:?}", analogue.status(), digital.status());
+            return None;
+        }
+    }
+    None
+}
+
+fn full_call() -> (Recall, f64) {
+    let mut analogue = Analogue::new(FS);
+    let mut digital = Digital::new(v92_server());
+    let seconds = run(&mut analogue, &mut digital, line(), 40.0).expect("the full start-up did not connect");
+    assert!(analogue.is_v90() && !analogue.short_phase2());
+    let learned = analogue.learned().expect("a V.92 server was met, and nothing was learned");
+    println!("full start-up: {seconds:.2} s, learned {learned:?}");
+    (learned, seconds)
+}
+
+/// A V.92 server and a V.92 analogue modem get through a full start-up as
+/// V.90's, and the analogue modem keeps what a Quick Connect needs.
+#[test]
+fn a_full_start_up_with_a_v92_server_connects_and_is_remembered() {
+    let (learned, _) = full_call();
+    assert!((0.02..0.08).contains(&(f64::from(learned.round_trip_ms) / 1000.0)), "{learned:?}");
+}
+
+/// The short Phase 2, with what the full one settled: both ends agree to it,
+/// both connect, and the start-up is quicker for having no probing.
+#[test]
+fn a_short_phase_2_with_what_was_learned_connects_sooner() {
+    let (learned, full) = full_call();
+    let mut analogue = Analogue::quick(learned, FS);
+    let mut digital = Digital::new(v92_server());
+    let quick = run(&mut analogue, &mut digital, line(), 40.0).expect("the short start-up did not connect");
+    println!("short start-up: {quick:.2} s against {full:.2} s");
+    assert!(analogue.short_phase2(), "the analogue modem did not do the short phase 2");
+    assert!(digital.v34().phase2().was_short(), "the digital modem did not do the short phase 2");
+    let Status::Connected { transmit, receive } = analogue.status() else { unreachable!() };
+    assert!(receive >= 48_000 && transmit >= 24_000, "{receive} down, {transmit} up");
+    assert!(quick < full, "{quick:.2} s is no quicker than {full:.2} s");
+}
+
+/// A server that does not offer the short Phase 2 gets the full one, asked
+/// for or not.
+#[test]
+fn a_server_without_the_short_phase_2_gets_the_full_one() {
+    let (learned, _) = full_call();
+    let mut analogue = Analogue::quick(learned, FS);
+    let mut digital = Digital::new(Info0d { short_phase2: false, ..v92_server() });
+    run(&mut analogue, &mut digital, line(), 40.0).expect("did not connect");
+    assert!(!analogue.short_phase2() && !digital.v34().phase2().was_short());
+}
+
+/// V.92's PCM upstream: a full start-up asking for it of a V.92 server that
+/// offers it, then `seconds` of data both ways, every bit checked.
+fn pcm_upstream_call(mut net: Network, seconds: f64) {
+    let mut analogue = Analogue::new(FS).with_pcm_upstream();
+    let mut digital = Digital::new(v92_server());
+    let mut up = Vec::new();
+    let connected = run_on(&mut analogue, &mut digital, &mut net, &mut up, 40.0);
+    println!("notes: {:?}", analogue.take_notes());
+    let connected = connected.expect("did not connect");
+    assert!(analogue.pcm_upstream(), "PCM upstream was not asked for");
+    let Status::Connected { transmit, receive } = analogue.status() else { unreachable!() };
+    println!("connected in {connected:.2} s: {receive} down, {transmit} up");
+    let mut x = 0x1234_5678_9abc_def1u64;
+    let mut random = |n: usize| -> Vec<bool> {
+        (0..n)
+            .map(|_| {
+                x ^= x << 13;
+                x ^= x >> 7;
+                x ^= x << 17;
+                x & 1 == 1
+            })
+            .collect()
+    };
+    // Rather less than either way carries, so that all of it arrives.
+    let up_sent = random((f64::from(transmit) * (seconds - 0.5)) as usize);
+    let down_sent = random((f64::from(receive) * (seconds - 0.5)) as usize);
+    analogue.send_bits(&up_sent);
+    digital.send_bits(&down_sent);
+    let (mut up_got, mut down_got) = (Vec::new(), Vec::new());
+    for _ in 0..(seconds * 8000.0) as usize {
+        let to_digital = net.up(&up);
+        up.clear();
+        let from_digital = digital.step(to_digital);
+        for x in net.down(from_digital) {
+            up.push(analogue.step(x));
+        }
+        up_got.extend(digital.take_bits());
+        down_got.extend(analogue.take_bits());
+        for note in analogue.take_notes() {
+            println!("analogue, {:.2} s into data: {note}", up_got.len() as f64 / f64::from(transmit));
+        }
+    }
+    assert!(matches!(analogue.status(), Status::Connected { .. }), "the analogue modem left data mode: {:?}", analogue.status());
+    let check = |name: &str, sent: &[bool], got: &[bool]| {
+        let window = 256;
+        let at = (0..got.len().saturating_sub(window)).find(|&i| got[i..i + window] == sent[..window]);
+        let at = at.unwrap_or_else(|| panic!("{name}: the data was not found in {} bits", got.len()));
+        let n = (got.len() - at).min(sent.len());
+        let wrong = got[at..at + n].iter().zip(sent).filter(|(a, b)| a != b).count();
+        println!("{name}: {n} bits, {wrong} wrong");
+        if wrong > 0 {
+            let chunk = n / 30;
+            let e: Vec<usize> = (0..30).map(|c| got[at + c * chunk..at + (c + 1) * chunk].iter().zip(&sent[c * chunk..]).filter(|(a, b)| a != b).count()).collect();
+            println!("{name} errors by {chunk}: {e:?}");
+        }
+        assert!(n == sent.len() && wrong == 0, "{name}: {n} of {} bits, {wrong} wrong", sent.len());
+    };
+    check("upstream", &up_sent, &up_got);
+    check("downstream", &down_sent, &down_got);
+}
+
+#[test]
+fn pcm_upstream_comes_up_and_carries_data() {
+    pcm_upstream_call(line(), 4.0);
+}
+
+/// A noisy line: the digital modem spaces its points to suit, and the
+/// upstream comes up slower but intact.
+#[test]
+fn pcm_upstream_on_a_noisy_line() {
+    pcm_upstream_call(Network::new(Law::Mu, FS).with_delay(0.020, FS).with_noise(1e-3), 6.0);
+}
+
+/// The sound card's clock is not the network's. PCM upstream must keep to the
+/// network's all the same, and does, by the downstream receiver's.
+#[test]
+fn pcm_upstream_keeps_to_the_network_clock() {
+    for ppm in [30.0, -30.0, 100.0, -100.0] {
+        println!("sound card {ppm} ppm off the network");
+        pcm_upstream_call(line().with_clock(ppm), 15.0);
+    }
+}
+
+/// A server that offers PCM upstream and then never answers CPt, so that its
+/// DIL goes on and on: the analogue modem gives up on Ri in a few seconds,
+/// says why, and the retrain comes up with V.34's upstream under V.90's
+/// downstream.
+#[test]
+fn a_server_that_never_answers_cpt_gets_v34_upstream_next() {
+    use datapump::v90::digital::Habits;
+    let mut analogue = Analogue::new(FS).with_pcm_upstream();
+    let mut digital = Digital::new(v92_server()).with_habits(Habits { hears_v92_cpt: false, ..Habits::PROMPT });
+    let seconds = run(&mut analogue, &mut digital, line(), 40.0);
+    let notes = analogue.take_notes();
+    println!("notes: {notes:?}");
+    let seconds = seconds.expect("did not connect");
+    assert!(notes.iter().any(|n| n.contains("no Ri")), "{notes:?}");
+    assert!(notes.iter().any(|n| n.contains("V.34 upstream next time")), "{notes:?}");
+    assert!(!analogue.pcm_upstream(), "still PCM upstream");
+    assert!(analogue.pcm_upstream_dropped());
+    let Status::Connected { transmit, receive } = analogue.status() else { unreachable!() };
+    println!("connected in {seconds:.2} s: {receive} down, {transmit} up");
+    assert!(receive >= 48_000 && seconds < 20.0, "{receive} down in {seconds:.2} s");
+}
