new file mode 100644
index 0000000..cfd564d
--- /dev/null
+++ b/crates/datapump/src/v92/server_up.rs
@@ -0,0 +1,549 @@
+//! The digital modem's ear for PCM upstream through phases 3 and 4 and data
+//! mode (9.5.1, 9.6.1/V.92): what it hears, as events for its start-up to
+//! act on.
+//!
+//! ```text
+//! heard:  Ru Ru' TRN1u Ja ... Su Su' Su ... Su' TRN1u ... CPt ... E1u TRN2u SUVu .. CPu .. SUVu' E2u B1u data
+//! events:    RuBar    Ja        SuTurned  SuTurnedAgain   Cpt     Trn2u     Suv    Cpu    Suv   E2u Data
+//! ```
+//!
+//! The line is learned twice from TRN1u: once after Ru, to read Ja by, and
+//! again after the second turn of Su, which the analogue modem has moved by
+//! half a symbol and Jp's fraction. The second is what CPd's prefilter and
+//! precoder are designed from (see [`super::receiver::Training::design`]).
+
+use crate::v90::sequences::{Cp, Descriptor, SYNC_ONES};
+use crate::v34::trellis::Code;
+use crate::v90::ucode::Law;
+
+use super::finder::{Direction, Finder, Found};
+use super::receiver::{self, Equaliser, RuFinder, SignReader, Trn2Reader, Training, REACH, TRAIN_OVER};
+use super::sequences::{self, CpKind, Cpd, Suv};
+use super::transmitter::{Decoder, FRAME, Params, Viterbi};
+use crate::v32::{Mode, Scrambler};
+
+/// What was heard.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Event {
+    /// Ru turned: TRN1u is next.
+    RuBar,
+    /// Ja read: the DIL asked for, and the upstream rates enabled.
+    Ja(Descriptor, u32),
+    /// Su's first turn (9.5.1.1.6): time for Jp.
+    SuTurned,
+    /// Su's second turn (9.5.1.1.9): time for Jp', and the DIL.
+    SuTurnedAgain,
+    /// CPt read (9.5.1.1.12).
+    Cpt(Cp),
+    /// E1u over and TRN2u begun.
+    Trn2u,
+    Suv(Suv),
+    /// CPu, or CPus.
+    Cpu(CpKind, Cp),
+    /// E2u: B1u next.
+    E2u,
+    /// The data mode's first frame decoded: B1u's scrambled ones.
+    InData,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Stage {
+    HuntRu,
+    Train1,
+    ReadJa,
+    AwaitSu,
+    AwaitSuAgain,
+    Train2,
+    ReadCpt,
+    ReadPhase4,
+    AwaitB1u,
+    Data,
+}
+
+/// The ear itself.
+#[derive(Debug, Clone)]
+pub struct UpReceiver {
+    #[allow(dead_code)]
+    law: Law,
+    levels: Vec<f64>,
+    stage: Stage,
+    ru: RuFinder,
+    su: RuFinder,
+    /// The level the Su finder's first was: it counts from there.
+    su_from: usize,
+    /// Where the TRN1u being learned from began, as near as its turn said.
+    trn_from: usize,
+    training: Option<Training>,
+    equaliser: Option<Equaliser>,
+    signs: SignReader,
+    /// The next level to read a symbol from.
+    next: usize,
+    /// Symbols read since the first of the second TRN1u.
+    symbol: usize,
+    ja_bits: Vec<bool>,
+    finder: Finder,
+    trn2: Option<Trn2Reader>,
+    last_sign: bool,
+    /// The last sign and the equaliser as they were at the start of the
+    /// frame being read, to go back to if it turns out to be TRN2u's first.
+    last_before_frame: bool,
+    equaliser_at_frame: Option<Equaliser>,
+    eight: bool,
+    small: usize,
+    /// Phase 4: bits read since TRN2u began, zeros running, where the last
+    /// sequence's fill ends, and whether an acknowledged one has come.
+    phase4_bits: usize,
+    frame_zeros: usize,
+    sequence_ends: Option<usize>,
+    acknowledged: bool,
+    /// Data: the transmitter's parameters, where B1u begins, and the decoder.
+    params: Option<Params>,
+    b1u_from: Option<usize>,
+    decoder: Option<Viterbi>,
+    descrambler: Scrambler,
+    data: Vec<bool>,
+}
+
+impl UpReceiver {
+    pub fn new(law: Law) -> Self {
+        Self {
+            law,
+            levels: Vec::new(),
+            stage: Stage::HuntRu,
+            ru: RuFinder::new(),
+            su: RuFinder::new(),
+            su_from: 0,
+            trn_from: 0,
+            training: None,
+            equaliser: None,
+            signs: SignReader::new(),
+            next: 0,
+            symbol: 0,
+            ja_bits: Vec::new(),
+            finder: Finder::new(Direction::Up),
+            trn2: None,
+            last_sign: false,
+            last_before_frame: false,
+            equaliser_at_frame: None,
+            eight: false,
+            small: 0,
+            phase4_bits: 0,
+            frame_zeros: 0,
+            sequence_ends: None,
+            acknowledged: false,
+            params: None,
+            b1u_from: None,
+            decoder: None,
+            descrambler: Scrambler::new(Mode::Answer),
+            data: Vec::new(),
+        }
+    }
+
+    /// TRN2u and phase 4's sequences on eight points rather than four.
+    pub fn set_eight(&mut self, eight: bool) {
+        self.eight = eight;
+    }
+
+    /// The training the second TRN1u gave, which CPd is designed from.
+    pub fn training(&self) -> Option<&Training> {
+        self.training.as_ref()
+    }
+
+    /// The CPd this end sent: data mode is read with what it says.
+    pub fn set_params(&mut self, params: Params) {
+        self.params = Some(params);
+    }
+
+    /// Bits data mode has carried, descrambled.
+    pub fn take_data(&mut self) -> Vec<bool> {
+        std::mem::take(&mut self.data)
+    }
+
+    /// One level from the codec, in the codec's linear units.
+    pub fn feed(&mut self, level: f64) -> Option<Event> {
+        self.levels.push(level);
+        let n = self.levels.len();
+        match self.stage {
+            Stage::HuntRu => {
+                let at = self.ru.feed(level)?;
+                // TRN1u's first symbol is Ru-bar's 24th after (no MD).
+                self.trn_from = (at + 24).saturating_sub(12);
+                self.stage = Stage::Train1;
+                Some(Event::RuBar)
+            }
+            Stage::Train1 | Stage::Train2 => {
+                if n < self.trn_from + TRAIN_OVER + REACH + 64 {
+                    return None;
+                }
+                let training = Training::solve(&self.levels, self.trn_from)?;
+                self.equaliser = Some(training.equaliser());
+                // TRN1u is 2040 symbols, so what follows starts there.
+                self.next = self.trn_from + 2040 + training.delay;
+                self.signs = SignReader::new();
+                self.training = Some(training);
+                if self.stage == Stage::Train1 {
+                    self.stage = Stage::ReadJa;
+                } else {
+                    self.stage = Stage::ReadCpt;
+                    self.symbol = 2040;
+                    self.finder = Finder::new(Direction::Up);
+                }
+                None
+            }
+            Stage::ReadJa => {
+                let symbol = self.equalised()?;
+                let bit = self.signs.bit(symbol);
+                self.ja_bits.push(bit);
+                if self.ja_bits.len() < SYNC_ONES + 40 {
+                    return None;
+                }
+                // A descriptor from each place a sync could have started.
+                let len = self.ja_bits.len();
+                for start in len.saturating_sub(3000)..len.saturating_sub(SYNC_ONES + 2) {
+                    if !self.ja_bits[start..start + SYNC_ONES].iter().all(|b| *b) || self.ja_bits[start + SYNC_ONES] {
+                        continue;
+                    }
+                    if start > 0 && self.ja_bits[start - 1] {
+                        continue;
+                    }
+                    let tail = &self.ja_bits[start..];
+                    if tail.len() < sequences::descriptor_length(tail) {
+                        continue;
+                    }
+                    if let Some((d, rates)) = sequences::descriptor_from_bits(tail) {
+                        self.stage = Stage::AwaitSu;
+                        self.su = RuFinder::new();
+                        self.su_from = n;
+                        return Some(Event::Ja(d, rates));
+                    }
+                }
+                None
+            }
+            Stage::AwaitSu => {
+                self.su.feed(level)?;
+                self.stage = Stage::AwaitSuAgain;
+                self.su = RuFinder::new();
+                self.su_from = n;
+                Some(Event::SuTurned)
+            }
+            Stage::AwaitSuAgain => {
+                let at = self.su_from + self.su.feed(level)?;
+                // Su-bar for 24T and the fraction, then TRN1u.
+                self.trn_from = (at + 24).saturating_sub(12);
+                self.stage = Stage::Train2;
+                Some(Event::SuTurnedAgain)
+            }
+            Stage::ReadCpt => {
+                let symbol = self.equalised()?;
+                // TRN2u's levels are 1 and 3 over root 5 (or 21): a frame
+                // mostly below 0.7 is no longer signs of one.
+                if symbol.abs() < 0.7 {
+                    self.small += 1;
+                }
+                self.symbol += 1;
+                if self.symbol.is_multiple_of(FRAME) {
+                    let small = std::mem::take(&mut self.small);
+                    if small >= FRAME / 2 {
+                        self.stage = Stage::ReadPhase4;
+                        // The frame just read was TRN2u's first: read it
+                        // again, from where everything was at its start.
+                        self.next -= FRAME;
+                        self.symbol -= FRAME;
+                        self.last_sign = self.last_before_frame;
+                        if let Some(eq) = self.equaliser_at_frame.take() {
+                            self.equaliser = Some(eq);
+                        }
+                        self.trn2 = Some(Trn2Reader::new(self.eight, self.last_sign));
+                        self.phase4_bits = 0;
+                        self.finder = Finder::new(Direction::Up);
+                        return Some(Event::Trn2u);
+                    }
+                    self.last_before_frame = self.last_sign;
+                    self.equaliser_at_frame = self.equaliser.clone();
+                }
+                self.last_sign = symbol < 0.0;
+                let bit = self.signs.bit(symbol);
+                match self.finder.feed(bit) {
+                    Some(Found::Cp(CpKind::Training, cp)) => Some(Event::Cpt(cp)),
+                    _ => None,
+                }
+            }
+            Stage::ReadPhase4 => {
+                let symbol = self.equalised_trn2()?;
+                self.symbol += 1;
+                let bits = self.trn2.as_mut().map(|r| r.bits(symbol)).unwrap_or_default();
+                let mut event = None;
+                let per_frame = bits.len() * FRAME;
+                for bit in bits {
+                    self.phase4_bits += 1;
+                    self.frame_zeros = if bit { 0 } else { self.frame_zeros + 1 };
+                    match self.finder.feed(bit) {
+                        Some(Found::Suv(suv)) => {
+                            self.acknowledged |= suv.acknowledge;
+                            event = Some(Event::Suv(suv));
+                        }
+                        Some(Found::Cp(kind, cp)) => {
+                            self.acknowledged |= cp.acknowledge;
+                            event = Some(Event::Cpu(kind, cp));
+                        }
+                        _ => {}
+                    }
+                    if event.is_some() {
+                        // Its fill runs to the next whole frame; whatever
+                        // comes next starts there.
+                        self.sequence_ends = Some(self.phase4_bits.div_ceil(per_frame) * per_frame);
+                    }
+                }
+                // E2u: once an acknowledged sequence has come, the first whole
+                // frame after a sequence's fill all zeros, where another
+                // sequence's ones would have begun. B1u starts after it.
+                if self.symbol.is_multiple_of(FRAME) {
+                    let frame_start = self.phase4_bits - per_frame;
+                    if self.acknowledged
+                        && self.sequence_ends == Some(frame_start)
+                        && self.frame_zeros >= per_frame
+                    {
+                        self.stage = Stage::AwaitB1u;
+                        self.b1u_from = Some(self.next);
+                        return Some(Event::E2u);
+                    }
+                    if self.sequence_ends.is_some_and(|e| e < frame_start) && self.frame_zeros < per_frame {
+                        self.sequence_ends = None;
+                    }
+                }
+                event
+            }
+            Stage::AwaitB1u | Stage::Data => self.read_data(),
+        }
+    }
+
+    /// The next symbol, equalised, once its level and those after it are in.
+    fn equalised(&mut self) -> Option<f64> {
+        let training = self.training.as_ref()?;
+        let y = training.forward(&self.levels, self.next)?;
+        self.next += 1;
+        let eq = self.equaliser.as_mut()?;
+        Some(eq.next(y, receiver::sign))
+    }
+
+    fn equalised_trn2(&mut self) -> Option<f64> {
+        let training = self.training.as_ref()?;
+        let y = training.forward(&self.levels, self.next)?;
+        self.next += 1;
+        let eight = self.eight;
+        let decide = move |x: f64| {
+            let scale = if eight { 21f64.sqrt() } else { 5f64.sqrt() };
+            let top = if eight { 7.0 } else { 3.0 };
+            let m = ((x.abs() * scale - 1.0) / 2.0).round().clamp(0.0, (top - 1.0) / 2.0);
+            x.signum() * (2.0 * m + 1.0) / scale
+        };
+        let eq = self.equaliser.as_mut()?;
+        Some(eq.next(y, decide))
+    }
+
+    /// Data mode: the codec's levels are the precoder's points, after the
+    /// line's delay and the prefilter's. Where B1u's first frame is is found
+    /// by trying the places near where it should be until a frame of B1u's
+    /// ones comes out.
+    fn read_data(&mut self) -> Option<Event> {
+        let params = self.params.clone()?;
+        let delay = self.training.as_ref()?.delay;
+        if self.stage == Stage::AwaitB1u {
+            let from = self.b1u_from? + REACH;
+            // Four frames of B1u to try each place against.
+            if self.levels.len() < from + 8 * FRAME + 6 * FRAME {
+                return None;
+            }
+            let _ = delay;
+            for offset in 0..6 * FRAME {
+                let mut decoder = Decoder::new(params.clone());
+                let mut descrambler = Scrambler::new(Mode::Answer);
+                let mut ok = 0;
+                for f in 0..6 {
+                    let at = from + offset + f * FRAME;
+                    let levels: [f64; FRAME] = std::array::from_fn(|i| self.levels[at + i]);
+                    let bits = decoder.frame(&decoder.slice(&levels));
+                    let descrambled: Vec<bool> = bits.into_iter().map(|b| descrambler.descramble(b)).collect();
+                    // The descrambler fills on the first frame.
+                    if f > 0 && descrambled.iter().all(|b| *b) {
+                        ok += 1;
+                    }
+                }
+                if ok >= 4 {
+                    let mut decoder = Viterbi::new(params.clone());
+                    let mut descrambler = Scrambler::new(Mode::Answer);
+                    // Decode up to here again, so both are where the line is.
+                    let mut at = from + offset;
+                    while at + FRAME <= self.levels.len() {
+                        let levels: [f64; FRAME] = std::array::from_fn(|i| self.levels[at + i]);
+                        for b in decoder.frame(&levels).into_iter().flatten() {
+                            descrambler.descramble(b);
+                        }
+                        at += FRAME;
+                    }
+                    self.decoder = Some(decoder);
+                    self.descrambler = descrambler;
+                    self.next = at;
+                    self.stage = Stage::Data;
+                    return Some(Event::InData);
+                }
+            }
+            // Not yet: perhaps B1u is later than thought.
+            if self.levels.len() > from + 60 * FRAME {
+                self.b1u_from = Some(self.b1u_from? + FRAME);
+            }
+            return None;
+        }
+        while self.next + FRAME <= self.levels.len() {
+            let levels: [f64; FRAME] = std::array::from_fn(|i| self.levels[self.next + i]);
+            let decoder = self.decoder.as_mut()?;
+            let bits = decoder.frame(&levels).unwrap_or_default();
+            self.data.extend(bits.into_iter().map(|b| self.descrambler.descramble(b)));
+            self.next += FRAME;
+        }
+        None
+    }
+}
+
+/// How far apart the constellation's points are, in the noise TRN1u left.
+const SPACING: f64 = 6.5;
+/// How far up the constellation goes, in TRN1u's level.
+const CEILING: f64 = 3.0;
+
+/// The CPd for data mode from what the second TRN1u taught (Table 30/V.92):
+/// the prefilter and precoder, the gain, constellations of codec levels
+/// spaced well clear of what the training left, and the fastest rate those
+/// carry among `enabled` (bit 0 for 24 000).
+pub fn design_cpd(training: &Training, law: Law, enabled: u32) -> Option<Cpd> {
+    let (filters, gain) = training.design();
+    let noise = training.error.sqrt() * training.level;
+    // Points 6.5 times the noise apart: with the trellis followed by
+    // Viterbi's algorithm, comfortably clear (5 is not, on the lines tried);
+    // and up to three times TRN1u's level, which keeps the line's power
+    // within a few dB of TRN1u's.
+    let points = receiver::constellation(law, (SPACING * noise).max(16.0), CEILING * training.level);
+    let n = 2 * points.positive.len();
+    // drn 1 is 24 000: (drn + 17) * 8000/6.
+    let (drn, moduli) = (1..=19u8).rev().find_map(|drn| {
+        let bits = 2 * (usize::from(drn) + 17);
+        let enabled_here = enabled >> (drn - 1) & 1 == 1;
+        enabled_here.then(|| receiver::moduli(bits, n)).flatten().map(|m| (drn, m))
+    })?;
+    let positive: Vec<u16> = points.positive.iter().map(|&p| p.round() as u16).collect();
+    Some(Cpd {
+        drn,
+        code: Code::States16,
+        extend_e2u: false,
+        acknowledge: false,
+        gain,
+        moduli: Some(moduli.map(|m| m as u8)),
+        filters: Some(filters),
+        constellations: Some(([0; 6], vec![positive])),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::v90::network::Network;
+    use crate::v92::up::Upstream;
+    use crate::v92::sequences::ALL_UPSTREAM_RATES;
+
+    const FS: f64 = 16_000.0;
+
+    /// The analogue modem's upstream, driven through phases 3 and 4 as its
+    /// downstream would drive it, against the digital modem's ear, through
+    /// the network; then data, every bit checked.
+    #[test]
+    fn phases_3_and_4_and_data_go_up_and_are_heard() {
+        let law = Law::Mu;
+        let mut net = Network::new(law, FS).with_delay(0.020, FS).with_noise(1e-5);
+        let d = crate::v90::dil::design(law, 79);
+        let ja = sequences::descriptor_bits(&d, ALL_UPSTREAM_RATES);
+        let mut up = Upstream::new(FS, ja, 0.05);
+        let mut ear = UpReceiver::new(law);
+        let full = receiver::codec_units(law);
+        let cpt = Cp { drn: 10, intervals: [0; 6], constellations: vec![0xffff_ffff_0000], ..Cp::default() };
+        let cpu = Cp { data_mode: true, drn: 19, intervals: [0; 6], constellations: vec![0xffff_ffff_0000], ..Cp::default() };
+        up.set_cpu(cpu);
+        let mut events = Vec::new();
+        let mut after: Vec<(usize, Box<dyn FnOnce(&mut Upstream)>)> = Vec::new();
+        let mut cpd_sent: Option<Cpd> = None;
+        let mut sent = Vec::new();
+        let mut x = 0x2545_f491_4f6c_dd1du64;
+        let mut upsamples = Vec::new();
+        let mut in_data_at = None;
+        for t in 0..(14.0 * 8000.0) as usize {
+            let level = net.up(&upsamples) * full;
+            upsamples.clear();
+            for _ in net.down(0.0) {
+                upsamples.push(up.sample(0.0, None));
+            }
+            // What the downstream would make the analogue modem do, a little
+            // after the digital modem acts.
+            let mut i = 0;
+            while i < after.len() {
+                if after[i].0 <= t {
+                    let (_, f) = after.remove(i);
+                    f(&mut up);
+                } else {
+                    i += 1;
+                }
+            }
+            if up.in_data() && up.pending_bits() < 1000 {
+                let b: Vec<bool> = (0..256)
+                    .map(|_| {
+                        x ^= x << 13;
+                        x ^= x >> 7;
+                        x ^= x << 17;
+                        x & 1 == 1
+                    })
+                    .collect();
+                sent.extend(b.iter().copied());
+                up.send_bits(&b);
+            }
+            let Some(event) = ear.feed(level) else { continue };
+            println!("{:6.3} s: {:?}", t as f64 / 8000.0, match &event { Event::Ja(..) => "Ja".to_owned(), e => format!("{e:?}").chars().take(60).collect() });
+            match &event {
+                // Sd, TRN1d and Jd take a while; Jd read, Su.
+                Event::Ja(..) => {
+                    after.push((t + 400, Box::new(|u: &mut Upstream| u.end_ja())));
+                    after.push((t + 4000, Box::new(|u: &mut Upstream| u.send_su())));
+                }
+                Event::SuTurned => after.push((t + 400, Box::new(|u: &mut Upstream| u.heard_jp(0.0, false)))),
+                // The DIL read: CPt.
+                Event::SuTurnedAgain => {
+                    let cpt = cpt.clone();
+                    after.push((t + 3000, Box::new(move |u: &mut Upstream| u.send_cpt(&cpt))));
+                }
+                Event::Cpt(_) => after.push((t + 400, Box::new(|u: &mut Upstream| u.heard_ri()))),
+                Event::Trn2u => {
+                    after.push((t + 2400, Box::new(|u: &mut Upstream| u.heard_suvd(Suv { acknowledge: false, level: Suv::UNMEASURED, ..Suv::default() }))));
+                }
+                Event::Cpu(CpKind::Data, cp) if cpd_sent.is_none() => {
+                    assert_eq!(cp.drn, 19);
+                    let cpd = design_cpd(ear.training().unwrap(), law, ALL_UPSTREAM_RATES).expect("no CPd");
+                    println!("CPd: {} bit/s", cpd.rate().unwrap());
+                    ear.set_params(cpd.params().expect("CPd has no parameters"));
+                    let acked = cpd.acknowledged();
+                    after.push((t + 400, Box::new(move |u: &mut Upstream| u.heard_cpd(acked))));
+                    cpd_sent = Some(cpd);
+                }
+                Event::InData => in_data_at = Some(t),
+                _ => {}
+            }
+            events.push(event);
+        }
+        let kinds: Vec<String> = events.iter().map(|e| format!("{e:?}").chars().take(8).collect()).collect();
+        println!("{kinds:?}");
+        assert!(in_data_at.is_some(), "never reached data mode");
+        let got = ear.take_data();
+        // B1u's ones decode away; the data comes after. Find it.
+        let window = 512;
+        let at = (0..got.len().saturating_sub(window)).find(|&i| got[i..i + window] == sent[..window]).expect("the data was not found");
+        let n = (got.len() - at).min(sent.len());
+        let wrong = got[at..at + n].iter().zip(&sent[..n]).filter(|(a, b)| a != b).count();
+        println!("{n} bits of data, {wrong} wrong");
+        assert!(n > 10_000 && wrong == 0, "{n} bits, {wrong} wrong");
+    }
+}
