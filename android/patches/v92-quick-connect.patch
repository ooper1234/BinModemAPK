+//! The digital modem's PCM upstream receiver: what the codec made of the
+//! analogue modem's waveform, one level every 125 microseconds, read back
+//! into what was sent (9.5.1, 9.6.1/V.92).
+//!
+//! Three things in turn. Finding where the analogue modem's signals begin:
+//! Ru repeats every six symbols and Ru-bar is it turned over, so a level set
+//! against the one six before it agrees all through Ru and disagrees across
+//! the turn (8.5.5). Learning the line from TRN1u, which is known from its
+//! first symbol -- signs of LU from a scrambler started at zero with ones
+//! going in (8.5.7) -- by least squares: a filter that takes the codec's
+//! levels back to the symbols. And reading: phase 3's sequences on TRN1u's
+//! signs, phase 4's on TRN2u's levels, both through that filter; and data
+//! mode's points straight off the codec, which the precoder and prefilter
+//! put there.
+//!
+//! The same filter is what this end asks the analogue modem to put in front
+//! of the line, as its prefilter (see [`Training::design`]): then the codec
+//! receives the precoder's points themselves, and its own quantising takes
+//! off the noise.
+
+use crate::v32::{Mode, Scrambler};
+use crate::v90::ucode::{self, Law, UCODES};
+
+use super::line::Signs;
+use super::sequences::Filters;
+use super::transmitter::{Constellation, FRAME};
+
+/// Equaliser taps either side of its centre.
+pub const REACH: usize = 16;
+
+/// Symbols fed back: the trailing echo a decided symbol leaves, which the
+/// analogue modem's precoder takes off before the line (6.4.2/V.92).
+pub const FEEDBACK: usize = 16;
+
+/// The signal-to-noise ratio, in dB, the equaliser is designed for whatever
+/// the line's own: see [`Training::solve`].
+pub const DESIGN_SNR: f64 = 30.0;
+
+/// TRN1u symbols the equaliser is solved over.
+pub const TRAIN_OVER: usize = 1536;
+
+/// The analogue modem's signals start where Ru turns over: the first
+/// symbol of Ru-bar, as a count of levels received.
+#[derive(Debug, Clone, Default)]
+pub struct RuFinder {
+    levels: Vec<f64>,
+    agreeing: usize,
+}
+
+impl RuFinder {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// One level; Some(n) when the level n was Ru-bar's first.
+    pub fn feed(&mut self, level: f64) -> Option<usize> {
+        self.levels.push(level);
+        let n = self.levels.len();
+        if n < 13 {
+            return None;
+        }
+        // How the last six agree with the six before them.
+        let (mut cross, mut power) = (0.0, 0.0);
+        for k in 0..6 {
+            let (a, b) = (self.levels[n - 1 - k], self.levels[n - 7 - k]);
+            cross += a * b;
+            power += 0.5 * (a * a + b * b);
+        }
+        if power < 1e-9 {
+            self.agreeing = 0;
+            return None;
+        }
+        let agreement = cross / power;
+        // Su is small, and the codec's quantising and the line's smearing
+        // leave a clean Su agreeing only to about 0.8 with itself, and its
+        // turn disagreeing to about as much: so 0.6 either way.
+        if agreement > 0.6 {
+            self.agreeing += 1;
+            return None;
+        }
+        // Ru for a good while, then the six just in disagree with the six
+        // before: Ru-bar began six symbols ago. Partway through the turn the
+        // agreement passes zero, which says nothing either way. "A good
+        // while" is short of Su's 144T, less the twelve symbols compared and
+        // the line's settling after silence: asked for 120, a turn could go
+        // unseen by a symbol or two, and then nothing turns again.
+        if agreement < -0.6 {
+            let found = (self.agreeing >= 96).then(|| n - 6);
+            self.agreeing = 0;
+            return found;
+        }
+        None
+    }
+}
+
+/// What TRN1u taught: a decision-feedback equaliser from the codec's levels
+/// back to the symbols, and how well it does.
+///
+/// A band the line takes away -- the codec's anti-alias filter leaves next
+/// to nothing near 4 kHz -- is beyond any linear filter: solved without
+/// feedback, the error stays at several per cent however long the filter.
+/// The feedback is what makes the difference, as it does in a decision
+/// feedback equaliser; here it moves to the analogue modem's precoder, which
+/// knows the symbols exactly, and the feedforward filter to its prefilter.
+#[derive(Debug, Clone)]
+pub struct Training {
+    /// Taps over levels n - REACH ..= n + REACH, giving, with the feedback,
+    /// the symbol sent `delay` symbols before level n arrived.
+    pub taps: Vec<f64>,
+    /// b(1..=FEEDBACK): the feedforward output is the symbol plus the sum of
+    /// b(k) times the symbol k before it.
+    pub feedback: Vec<f64>,
+    /// Levels arrive this many symbols after the symbol they carry most of.
+    pub delay: usize,
+    /// The mean square of what the filter leaves, against a symbol of one.
+    pub error: f64,
+    /// How large a symbol of one arrives, in the codec's units: the line's
+    /// gain.
+    pub level: f64,
+}
+
+impl Training {
+    /// Solve for the filter over TRN1u, which began with level `start` (as
+    /// near as Ru said), trying alignments either side.
+    pub fn solve(levels: &[f64], start: usize) -> Option<Self> {
+        let mut signs = Signs::new();
+        let sent: Vec<f64> = (0..TRAIN_OVER + 64).map(|_| signs.trn1u()).collect();
+        let mut best: Option<Self> = None;
+        for delay in 0..=24 {
+            let Some(t) = Self::solve_at(levels, start, delay, &sent) else { continue };
+            if best.as_ref().is_none_or(|b| t.error < b.error) {
+                best = Some(t);
+            }
+        }
+        best
+    }
+
+    fn solve_at(levels: &[f64], start: usize, delay: usize, sent: &[f64]) -> Option<Self> {
+        let forward = 2 * REACH + 1;
+        let width = forward + FEEDBACK;
+        let mut ata = vec![vec![0.0; width]; width];
+        let mut atb = vec![0.0; width];
+        let mut count = 0;
+        let mut energy = 0.0;
+        for k in 32..TRAIN_OVER {
+            // Level n carries most of symbol k: n = start + k + delay.
+            let n = start + k + delay;
+            if n < REACH || n + REACH >= levels.len() {
+                return None;
+            }
+            // The regressors: the levels around, and the symbols just before
+            // with their sign turned, so that the solution's last FEEDBACK
+            // values are b(k) as the feedforward output's echo of them.
+            let mut row: Vec<f64> = levels[n - REACH..=n + REACH].to_vec();
+            row.extend((1..=FEEDBACK).map(|j| -sent.get(k.wrapping_sub(j)).copied().unwrap_or(0.0)));
+            for i in 0..width {
+                atb[i] += row[i] * sent[k];
+                for j in 0..width {
+                    ata[i][j] += row[i] * row[j];
+                }
+            }
+            energy += levels[n] * levels[n];
+            count += 1;
+        }
+        // Solved as if the line had a noise floor DESIGN_SNR below the
+        // signal even where it has next to none. Without it the solution is
+        // zero-forcing: it notches the band the line takes away so deeply
+        // that the precoder's feedback, undoing the notch, puts most of the
+        // analogue modem's power exactly there, and any error in the
+        // solution with it. With it the solution is the MMSE one, which
+        // gives that band up.
+        let ridge = (0..forward).map(|i| ata[i][i]).sum::<f64>() / forward as f64 * 10f64.powf(-DESIGN_SNR / 10.0);
+        for (i, row) in ata.iter_mut().enumerate().take(forward) {
+            row[i] += ridge;
+        }
+        let solution = solve(ata, atb)?;
+        let (taps, feedback) = (solution[..forward].to_vec(), solution[forward..].to_vec());
+        let mut error = 0.0;
+        for k in 32..TRAIN_OVER {
+            let n = start + k + delay;
+            let y: f64 = taps.iter().zip(&levels[n - REACH..=n + REACH]).map(|(t, l)| t * l).sum::<f64>()
+                - (1..=FEEDBACK).map(|j| feedback[j - 1] * sent[k - j]).sum::<f64>();
+            error += (y - sent[k]).powi(2);
+        }
+        Some(Self { taps, feedback, delay, error: error / count as f64, level: (energy / count as f64).sqrt() })
+    }
+
+    /// The feedforward filter's output at level n: the symbol it most
+    /// carries, plus the echo of the ones before (see [`Equaliser`]).
+    pub fn forward(&self, levels: &[f64], n: usize) -> Option<f64> {
+        if n < REACH || n + REACH >= levels.len() {
+            return None;
+        }
+        Some(self.taps.iter().zip(&levels[n - REACH..=n + REACH]).map(|(t, l)| t * l).sum())
+    }
+
+    /// An equaliser that runs on, taking the echo of its own decisions off.
+    pub fn equaliser(&self) -> Equaliser {
+        Equaliser { feedback: self.feedback.clone(), decided: vec![0.0; self.feedback.len()] }
+    }
+
+    /// The prefilter this end asks for, and its gain: this filter itself,
+    /// turned round to run on the analogue modem's side of the line. Its
+    /// taps scaled so the largest fits Q0.15, and G making up the scale, so
+    /// that the codec receives the precoder's output as it was:
+    /// the line's gain `level` times the filter is about a delay.
+    pub fn design(&self) -> (Filters, f64) {
+        // The filter maps codec units to symbols of one; on the far side it
+        // maps the precoder's codec units to symbols, which the line maps
+        // back. z2(k) runs in time order, so the window is reversed.
+        let mut z2: Vec<f64> = self.taps.iter().rev().copied().collect();
+        let largest = z2.iter().fold(0.0f64, |m, z| m.max(z.abs()));
+        let scale = 0.98 / largest;
+        for z in &mut z2 {
+            *z *= scale;
+        }
+        // The line and prefilter together leave each point plus b(k) times
+        // the point k before; x(n) = u(n) + sum p1(k) x(n - k) with p1 = -b
+        // takes that off before it happens.
+        let p1 = self.feedback.iter().map(|b| (-b).clamp(-1.99, 1.99)).collect();
+        (Filters { z1: Vec::new(), p1, z2, p2: Vec::new() }, 1.0 / scale)
+    }
+
+    /// Symbols the prefilter delays by: the analogue modem's x(n) arrives
+    /// this many symbols after its own delay plus the line's.
+    pub fn prefilter_delay(&self) -> usize {
+        REACH
+    }
+}
+
+/// The decision-feedback half of reading phase 3 and 4's sequences: the
+/// feedforward output, less the echo of what was decided before.
+#[derive(Debug, Clone)]
+pub struct Equaliser {
+    feedback: Vec<f64>,
+    decided: Vec<f64>,
+}
+
+impl Equaliser {
+    /// One symbol: the feedforward output `y` in, the equalised symbol out;
+    /// `decide` says which symbol it was, to be fed back.
+    pub fn next(&mut self, y: f64, decide: impl Fn(f64) -> f64) -> f64 {
+        let echo: f64 = self.feedback.iter().zip(&self.decided).map(|(b, d)| b * d).sum();
+        let symbol = y - echo;
+        if !self.decided.is_empty() {
+            self.decided.rotate_right(1);
+            self.decided[0] = decide(symbol);
+        }
+        symbol
+    }
+}
+
+/// Decisions for signs of one.
+pub fn sign(x: f64) -> f64 {
+    if x < 0.0 { -1.0 } else { 1.0 }
+}
+
+/// A set of linear equations, solved by elimination with pivoting.
+fn solve(mut a: Vec<Vec<f64>>, mut b: Vec<f64>) -> Option<Vec<f64>> {
+    let n = b.len();
+    for col in 0..n {
+        let pivot = (col..n).max_by(|&i, &j| a[i][col].abs().total_cmp(&a[j][col].abs()))?;
+        if a[pivot][col].abs() < 1e-300 {
+            return None;
+        }
+        a.swap(col, pivot);
+        b.swap(col, pivot);
+        for row in col + 1..n {
+            let f = a[row][col] / a[col][col];
+            if f == 0.0 {
+                continue;
+            }
+            for k in col..n {
+                a[row][k] -= f * a[col][k];
+            }
+            b[row] -= f * b[col];
+        }
+    }
+    let mut x = vec![0.0; n];
+    for row in (0..n).rev() {
+        let s: f64 = (row + 1..n).map(|k| a[row][k] * x[k]).sum();
+        x[row] = (b[row] - s) / a[row][row];
+    }
+    Some(x)
+}
+
+/// Reads the bits of phase 3's sequences off the signs: decided, the
+/// differential encoding taken off, and descrambled with GPA.
+#[derive(Debug, Clone)]
+pub struct SignReader {
+    descrambler: Scrambler,
+    last: bool,
+}
+
+impl Default for SignReader {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl SignReader {
+    pub fn new() -> Self {
+        Self { descrambler: Scrambler::new(Mode::Answer), last: false }
+    }
+
+    pub fn bit(&mut self, symbol: f64) -> bool {
+        let sign = symbol < 0.0;
+        let scrambled = sign ^ self.last;
+        self.last = sign;
+        self.descrambler.descramble(scrambled)
+    }
+}
+
+/// Reads TRN2u's levels back to bits, least significant first.
+#[derive(Debug, Clone)]
+pub struct Trn2Reader {
+    descrambler: Scrambler,
+    eight: bool,
+    last: bool,
+}
+
+impl Trn2Reader {
+    pub fn new(eight: bool, last_sign: bool) -> Self {
+        Self { descrambler: Scrambler::new(Mode::Answer), eight, last: last_sign }
+    }
+
+    pub fn bits(&mut self, symbol: f64) -> Vec<bool> {
+        let scale = if self.eight { 21f64.sqrt() } else { 5f64.sqrt() };
+        let top = if self.eight { 3 } else { 1 };
+        let magnitude = (((symbol.abs() * scale - 1.0) / 2.0).round() as i64).clamp(0, top) as u32;
+        let sign = symbol < 0.0;
+        let n = if self.eight { 3 } else { 2 };
+        let mut scrambled: Vec<bool> = (0..n - 1).map(|i| magnitude >> i & 1 == 1).collect();
+        scrambled.push(sign ^ self.last);
+        self.last = sign;
+        scrambled.into_iter().map(|b| self.descrambler.descramble(b)).collect()
+    }
+}
+
+/// Constellations for data mode from what training found: codec levels as
+/// far apart as `spacing` codec units at least, from the smallest up to
+/// `ceiling`, for every interval alike.
+pub fn constellation(law: Law, spacing: f64, ceiling: f64) -> Constellation {
+    let mut positive = Vec::new();
+    let mut last = 0.0;
+    for u in 0..UCODES as u8 {
+        let level = f64::from(ucode::linear(law, u));
+        if level <= 0.0 || level > ceiling {
+            continue;
+        }
+        // The smallest stands half a spacing from zero, so that it is a
+        // spacing from its own negative; each after it a spacing from the last.
+        let clear = if positive.is_empty() { level >= spacing / 2.0 } else { level - last >= spacing };
+        if clear {
+            positive.push(level);
+            last = level;
+        }
+    }
+    Constellation { positive }
+}
+
+/// Moduli for `bits` a frame from constellations of `n` points: the first
+/// three of every four symbols take a number less than M, the fourth less
+/// than M with each class two points wide. Every class keeps at least two
+/// points to choose from: with one, the precoder cannot keep its own output
+/// down, and the feedback that undoes the line runs away with it.
+pub fn moduli(bits: usize, n: usize) -> Option<[u32; FRAME]> {
+    for m3 in (1..=n as u32 / 4).rev() {
+        for m in (1..=n as u32 / 2).rev() {
+            let product = (u128::from(m)).pow(9) * u128::from(m3).pow(3);
+            if product >= 1u128 << bits {
+                continue;
+            }
+            // One step up is the smallest that carries it.
+            let (m, m3) = if m < n as u32 / 2 { (m + 1, m3) } else { (m, m3) };
+            let product = (u128::from(m)).pow(9) * u128::from(m3).pow(3);
+            if product >= 1u128 << bits {
+                return Some(std::array::from_fn(|i| if i % 4 == 3 { m3 } else { m }));
+            }
+            break;
+        }
+    }
+    None
+}
+
+/// The level a symbol of one is as the codec's linear output, in the units
+/// [`ucode::linear`] gives -- what [`Training::level`] is measured in, for
+/// a line that delivers codec levels as fractions of full scale.
+pub fn codec_units(law: Law) -> f64 {
+    f64::from(ucode::linear(law, (UCODES - 1) as u8))
+}
