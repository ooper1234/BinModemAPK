new file mode 100644
index 0000000..ef52901
--- /dev/null
+++ b/crates/datapump/src/v92/up.rs
@@ -0,0 +1,552 @@
+//! What the analogue modem sends upstream when PCM upstream was asked for:
+//! V.92's phase 3, phase 4 and data mode, one symbol at a time (9.5.2,
+//! 9.6.2/V.92).
+//!
+//! ```text
+//! analogue Ru Ru' (MD) Ru Ru' TRN1u Ja ... | Su Su' Su ... Su' TRN1u CPt ... E1u TRN2u SUVu .. CPu .. SUVu' E2u B1u data
+//! digital                     Sd Sd' TRN1d Jd ... Jp ... Jp' DIL ...  Ri ... Ri' TRN2d SUVd .. CPd .. SUVd' Ed B1d data
+//! ```
+//!
+//! The analogue modem's start-up says when each part begins, from what its
+//! downstream receiver hears; this says what goes on the line meanwhile, and
+//! keeps phase 4's sequences to the rules of 9.6.2.1: SUVu once TRN2u has
+//! run long enough or SUVd has been heard, one CPu after the first SUVd, an
+//! acknowledged CPu and SUVu once CPd is in, CPu again if the digital modem
+//! has not acknowledged it, and E2u once both ends have.
+
+use std::collections::VecDeque;
+
+use crate::v32::{Mode, Scrambler};
+use crate::v90::sequences::Cp;
+
+use super::line::{self, Signs, Trn2, UpLine};
+use super::sequences::{self, CpKind, Cpd, Suv};
+use super::transmitter::{FRAME, Params, Transmitter};
+
+/// LU on the line, as a fraction of full scale: about -15 dBm0, where V.90's
+/// upstream sits.
+pub const LU: f64 = 0.12;
+
+/// Ru, then Ru-bar (9.5.2.1.1).
+const RU: usize = 384;
+const RU_BAR: usize = 24;
+
+/// TRN1u: "at least 2040T", in whole frames of twelve.
+const TRN1U: usize = 2040;
+
+/// Su before its first turn (9.5.2.1.6), and Su-bar's lengths (9.5.2.1.7,
+/// 9.5.2.1.8).
+const SU_FIRST: usize = 144;
+const SU_BAR_FIRST: usize = 24;
+const SU_BAR_SECOND: usize = 24;
+
+/// TRN2u before SUVu unless SUVd comes first: "at least 12000T" (9.6.2.1.1).
+const TRN2U: usize = 12_000;
+
+/// B1u: "48 data frames" (8.7.1).
+const B1U_FRAMES: usize = 48;
+
+/// What is going up.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Up {
+    Silence,
+    Ru,
+    RuBar,
+    Trn1u,
+    Ja,
+    Su,
+    SuBar,
+    /// TRN1u through the DIL.
+    Trn1uDil,
+    Cpt,
+    E1u,
+    Trn2u,
+    /// SUVu and CPu, as phase 4's rules have them.
+    Phase4,
+    E2u,
+    B1u,
+    Data,
+}
+
+/// The upstream, from phase 3 on.
+#[derive(Debug, Clone)]
+pub struct Upstream {
+    line: UpLine,
+    up: Up,
+    /// Symbols of the current signal sent.
+    count: usize,
+    /// Symbols since the first of the second TRN1u: data frame intervals
+    /// are counted from there (8.5.7).
+    since_trn1u: Option<usize>,
+    signs: Signs,
+    trn2: Option<Trn2>,
+    eight: bool,
+    /// Bits of the sequence going out, and what it is.
+    queue: VecDeque<bool>,
+    ja: Vec<bool>,
+    cpt: Vec<bool>,
+    /// The next signal, at the next place the current one can end.
+    pending: Option<Up>,
+    /// Phase 4: what the digital modem has said, and what this end has.
+    suvd_heard: bool,
+    cpd: Option<Cpd>,
+    far_acknowledged: bool,
+    ed: bool,
+    cpu: Option<Cp>,
+    cpu_sent: usize,
+    acknowledged_sent: usize,
+    /// When the last CPu ended, in symbols, for 9.6.2.1.3's repeat.
+    cpu_ended: Option<usize>,
+    repeat_cpu: bool,
+    round_trip: usize,
+    /// Data mode.
+    transmitter: Option<Transmitter>,
+    scrambler: Scrambler,
+    data: VecDeque<bool>,
+    frame: VecDeque<f64>,
+    b1u_left: usize,
+    /// What has just begun going out, for the transcript.
+    began: Option<String>,
+    /// Where in its six-symbol pattern Su is: Su-bar is Su turned over in
+    /// step with it, never begun again.
+    su_phase: usize,
+    /// A shift of the symbol clock asked for while a symbol was being
+    /// chosen, applied before the next line sample.
+    stretch: f64,
+}
+
+impl Upstream {
+    /// `ja` is the DIL descriptor with its rate mask, as Ja repeats it.
+    pub fn new(fs: f64, ja: Vec<bool>, round_trip: f64) -> Self {
+        Self {
+            line: UpLine::new(fs),
+            up: Up::Silence,
+            count: 0,
+            since_trn1u: None,
+            signs: Signs::new(),
+            trn2: None,
+            eight: false,
+            queue: VecDeque::new(),
+            ja,
+            cpt: Vec::new(),
+            pending: Some(Up::Ru),
+            suvd_heard: false,
+            cpd: None,
+            far_acknowledged: false,
+            ed: false,
+            cpu: None,
+            cpu_sent: 0,
+            acknowledged_sent: 0,
+            cpu_ended: None,
+            repeat_cpu: false,
+            round_trip: (round_trip * line::BAUD) as usize,
+            transmitter: None,
+            scrambler: Scrambler::new(Mode::Answer),
+            data: VecDeque::new(),
+            frame: VecDeque::new(),
+            b1u_left: 0,
+            began: None,
+            su_phase: 0,
+            stretch: 0.0,
+        }
+    }
+
+    pub fn up(&self) -> Up {
+        self.up
+    }
+
+    /// One line sample: `drift` is how far the sound card runs off the
+    /// network's clock, in ppm, as the downstream receiver has it.
+    ///
+    /// `clock`, once the downstream receiver has trained, is where it has
+    /// the network's symbols at this sample, and the upstream keeps to it;
+    /// `drift` is used until then.
+    pub fn sample(&mut self, drift: f64, clock: Option<f64>) -> f64 {
+        match clock {
+            Some(clock) => self.line.follow(clock),
+            None if !self.line.following() => self.line.set_drift(drift),
+            None => {}
+        }
+        let mut line = std::mem::replace(&mut self.line, UpLine::new(1.0));
+        let out = line.sample(|| self.next());
+        line.extend(std::mem::take(&mut self.stretch));
+        self.line = line;
+        LU * out
+    }
+
+    /// What has just begun, if anything, for the transcript.
+    pub fn take_began(&mut self) -> Option<String> {
+        self.began.take()
+    }
+
+    /// 9.5.2.1.3: Sd-bar heard, so Ja ends at its next twelve bits, and
+    /// silence.
+    pub fn end_ja(&mut self) {
+        self.pending = Some(Up::Silence);
+    }
+
+    /// Ja again: what Sd set off was not Sd.
+    pub fn resume_ja(&mut self) {
+        self.pending = Some(Up::Ja);
+    }
+
+        /// 9.5.2.1.6: Jd read: Su for 144T, Su-bar for 24.5T, then Su until Jp.
+    pub fn send_su(&mut self) {
+        if !matches!(self.up, Up::Su | Up::SuBar) {
+            self.pending = Some(Up::Su);
+        }
+    }
+
+    /// 9.5.2.1.8: Jp read: Su-bar for 24T and the fraction it asks for, and
+    /// TRN1u after it, through the DIL; TRN2u and CPu are on `eight` points
+    /// if Jp says so.
+    pub fn heard_jp(&mut self, fraction: f64, eight: bool) {
+        if self.up == Up::Su && self.count >= SU_FIRST + SU_BAR_FIRST {
+            self.eight = eight;
+            self.line.extend(fraction);
+            self.start(Up::SuBar);
+        }
+    }
+
+    /// 9.5.2.1.11: the DIL is read: CPt after at least 2040T of TRN1u, over
+    /// and over until Ri.
+    pub fn send_cpt(&mut self, cpt: &Cp) {
+        self.cpt = sequences::cp_bits(cpt, CpKind::Training);
+        self.pending = Some(Up::Cpt);
+    }
+
+    /// 9.5.2.1.11: Ri heard: the current CPt whole, E1u, and phase 4.
+    pub fn heard_ri(&mut self) {
+        if self.up == Up::Cpt {
+            self.pending = Some(Up::E1u);
+        }
+    }
+
+    /// The CPu this end sends, once it knows what it wants downstream.
+    pub fn set_cpu(&mut self, cp: Cp) {
+        self.cpu = Some(cp);
+    }
+
+    /// 9.6.2.1.1 and 9.6.2.1.2: SUVd heard.
+    pub fn heard_suvd(&mut self, suv: Suv) {
+        self.suvd_heard = true;
+        if suv.acknowledge {
+            self.far_acknowledged = true;
+        }
+        if self.up == Up::Trn2u {
+            self.pending = Some(Up::Phase4);
+        }
+    }
+
+    /// 9.6.2.1.2: CPd heard, which sets the transmitter up.
+    pub fn heard_cpd(&mut self, cpd: Cpd) {
+        if cpd.acknowledge {
+            self.far_acknowledged = true;
+        }
+        // A CPd may leave a part out when it is unchanged: keep the last.
+        let merged = match self.cpd.take() {
+            Some(old) => Cpd {
+                moduli: cpd.moduli.or(old.moduli),
+                filters: cpd.filters.clone().or(old.filters),
+                constellations: cpd.constellations.clone().or(old.constellations),
+                ..cpd
+            },
+            None => cpd,
+        };
+        self.cpd = Some(merged);
+    }
+
+    /// Ed heard: as good as an acknowledgement (9.6.2.1.4).
+    pub fn heard_ed(&mut self) {
+        self.ed = true;
+    }
+
+    /// The CPd this end is going on, and the transmitter it sets up.
+    pub fn cpd(&self) -> Option<&Cpd> {
+        self.cpd.as_ref()
+    }
+
+    pub fn params(&self) -> Option<Params> {
+        self.cpd.as_ref()?.params()
+    }
+
+    /// The upstream rate data mode will run at.
+    pub fn rate(&self) -> Option<u32> {
+        self.params().map(|p| p.rate())
+    }
+
+    /// Whether data mode has begun upstream.
+    pub fn in_data(&self) -> bool {
+        self.up == Up::Data
+    }
+
+    /// Bits for data mode.
+    pub fn send_bits(&mut self, bits: &[bool]) {
+        self.data.extend(bits.iter().copied());
+    }
+
+    pub fn pending_bits(&self) -> usize {
+        self.data.len()
+    }
+
+    fn start(&mut self, up: Up) {
+        self.up = up;
+        self.count = 0;
+        self.queue.clear();
+        match up {
+            Up::Trn1u => {
+                // "The scrambler shall be initialized to zero prior to the
+                // transmission of TRN1u" (8.5.7).
+                self.signs.restart();
+            }
+            Up::Ja => {
+                // "Sequence Ja consists of 24 binary ones followed by
+                // repetitions of the DIL descriptor".
+                self.queue.extend([true; 24]);
+                self.began = Some("sent Ja: the DIL descriptor and the upstream rates".into());
+            }
+            Up::Trn1uDil => {
+                // TRN1u again: data frame intervals counted from its first
+                // symbol (8.5.7).
+                self.signs.restart();
+                self.since_trn1u = Some(0);
+            }
+            Up::Cpt => {
+                // "24 differentially encoded binary ones shall be transmitted
+                // prior to transmitting the first CPt in a series" (8.5.1):
+                // what tells the digital modem TRN1u is over.
+                self.queue.extend([true; 24]);
+                self.began = Some("sent CPt".into());
+            }
+            Up::E1u => {
+                // A data frame of scrambled, differentially encoded zeros.
+                self.queue.extend([false; FRAME]);
+            }
+            Up::Trn2u => {
+                let mut trn2 = Trn2::new(self.eight, self.signs.last());
+                trn2.restart();
+                self.trn2 = Some(trn2);
+                self.began = Some(format!("sent TRN2u on {} points", if self.eight { 8 } else { 4 }));
+            }
+            Up::E2u => {
+                let n = self.trn2.as_ref().map_or(2, Trn2::bits_per_symbol);
+                self.queue.extend(std::iter::repeat_n(false, n * FRAME));
+                self.began = Some("sent E2u: B1u and data next".into());
+            }
+            Up::B1u => {
+                // "The scrambler, modulus encoder, convolutional encoder,
+                // precoder and prefilter memories are initialized to zero
+                // prior to transmitting B1u" (8.7.1).
+                self.scrambler = Scrambler::new(Mode::Answer);
+                self.transmitter = self.params().map(Transmitter::new);
+                self.b1u_left = B1U_FRAMES;
+                self.frame.clear();
+                self.began = self.rate().map(|r| format!("sent B1u: data mode up at {r} bit/s"));
+            }
+            _ => {}
+        }
+    }
+
+    /// The next symbol, in units of LU.
+    fn next(&mut self) -> f64 {
+        if let Some(n) = self.since_trn1u.as_mut() {
+            *n += 1;
+        }
+        loop {
+            match self.up {
+                Up::Silence => {
+                    if let Some(next) = self.pending.take() {
+                        self.start(next);
+                        continue;
+                    }
+                    return 0.0;
+                }
+                Up::Ru | Up::RuBar => {
+                    let length = if self.up == Up::Ru { RU } else { RU_BAR };
+                    if self.count == length {
+                        self.start(if self.up == Up::Ru { Up::RuBar } else { Up::Trn1u });
+                        continue;
+                    }
+                    let s = line::ru(self.count, self.up == Up::RuBar);
+                    self.count += 1;
+                    return s;
+                }
+                Up::Trn1u => {
+                    if self.count >= TRN1U && self.count.is_multiple_of(FRAME) {
+                        self.start(Up::Ja);
+                        continue;
+                    }
+                    self.count += 1;
+                    return self.signs.trn1u();
+                }
+                Up::Ja => {
+                    // Ends at a twelve-bit boundary once asked to.
+                    if self.count.is_multiple_of(12) && let Some(next) = self.pending.take() {
+                        self.start(next);
+                        continue;
+                    }
+                    if self.queue.is_empty() {
+                        self.queue.extend(self.ja.iter().copied());
+                    }
+                    let bit = self.queue.pop_front().unwrap_or(true);
+                    self.count += 1;
+                    return self.signs.differential(bit);
+                }
+                Up::Su | Up::SuBar => {
+                    // Su for 144T and Su-bar for 24.5T -- the half symbol a
+                    // shift of the clock -- then Su until Jp, Su-bar for 24T
+                    // and the fraction, and TRN1u.
+                    if self.up == Up::Su && self.count == SU_FIRST {
+                        self.up = Up::SuBar;
+                        continue;
+                    }
+                    if self.up == Up::SuBar && self.count == SU_FIRST + SU_BAR_FIRST {
+                        self.stretch += 0.5;
+                        self.up = Up::Su;
+                        continue;
+                    }
+                    if self.up == Up::SuBar && self.count >= SU_BAR_SECOND && self.count < SU_FIRST {
+                        // The second Su-bar, begun by Jp: `count` restarted.
+                        self.start(Up::Trn1uDil);
+                        continue;
+                    }
+                    let s = line::su(self.su_phase, self.up == Up::SuBar);
+                    self.su_phase += 1;
+                    self.count += 1;
+                    return s;
+                }
+                Up::Trn1uDil => {
+                    if self.count >= TRN1U
+                        && self.since_trn1u.is_some_and(|n| n.is_multiple_of(FRAME))
+                        && let Some(next) = self.pending.take()
+                    {
+                        self.start(next);
+                        continue;
+                    }
+                    self.count += 1;
+                    return self.signs.trn1u();
+                }
+                Up::Cpt => {
+                    if self.queue.is_empty() {
+                        if let Some(next) = self.pending.take() {
+                            self.start(next);
+                            continue;
+                        }
+                        self.queue.extend(self.cpt.iter().copied());
+                    }
+                    let bit = self.queue.pop_front().unwrap_or(false);
+                    self.count += 1;
+                    return self.signs.differential(bit);
+                }
+                Up::E1u => {
+                    if self.queue.is_empty() {
+                        self.start(Up::Trn2u);
+                        continue;
+                    }
+                    let bit = self.queue.pop_front().unwrap_or(false);
+                    self.count += 1;
+                    return self.signs.differential(bit);
+                }
+                Up::Trn2u => {
+                    // In whole frames; SUVu once 12000T have gone or SUVd has
+                    // been heard.
+                    if self.count.is_multiple_of(FRAME) && (self.count >= TRN2U || self.pending == Some(Up::Phase4)) {
+                        self.pending = None;
+                        self.start(Up::Phase4);
+                        continue;
+                    }
+                    let ones = vec![true; self.trn2.as_ref().map_or(2, Trn2::bits_per_symbol)];
+                    self.count += 1;
+                    return self.trn2.as_mut().map_or(0.0, |t| t.symbol(&ones));
+                }
+                Up::Phase4 => {
+                    if self.queue.is_empty() {
+                        if self.phase4_next() {
+                            continue;
+                        }
+                    }
+                    return self.trn2_symbol();
+                }
+                Up::E2u => {
+                    if self.queue.is_empty() {
+                        self.start(Up::B1u);
+                        continue;
+                    }
+                    return self.trn2_symbol();
+                }
+                Up::B1u | Up::Data => {
+                    if self.frame.is_empty() {
+                        if self.up == Up::B1u {
+                            if self.b1u_left == 0 {
+                                self.up = Up::Data;
+                                self.began = Some("data mode upstream".into());
+                                continue;
+                            }
+                            self.b1u_left -= 1;
+                        }
+                        let k = self.transmitter.as_ref().map_or(0, |t| t.params().bits);
+                        let source: Vec<bool> = if self.up == Up::B1u {
+                            vec![true; k]
+                        } else {
+                            (0..k).map(|_| self.data.pop_front().unwrap_or(true)).collect()
+                        };
+                        let scrambled: Vec<bool> = source.into_iter().map(|b| self.scrambler.scramble(b)).collect();
+                        let Some(tx) = self.transmitter.as_mut() else { return 0.0 };
+                        self.frame.extend(tx.frame(&scrambled));
+                    }
+                    return self.frame.pop_front().unwrap_or(0.0);
+                }
+            }
+        }
+    }
+
+    /// One symbol of what phase 4 has queued, on TRN2u's levels.
+    fn trn2_symbol(&mut self) -> f64 {
+        let n = self.trn2.as_ref().map_or(2, Trn2::bits_per_symbol);
+        let bits: Vec<bool> = (0..n).map(|_| self.queue.pop_front().unwrap_or(false)).collect();
+        self.count += 1;
+        self.trn2.as_mut().map_or(0.0, |t| t.symbol(&bits))
+    }
+
+    /// What phase 4 sends next, its rules applied at a sequence's end. True
+    /// when the signal changed.
+    fn phase4_next(&mut self) -> bool {
+        let acknowledging = self.cpd.is_some();
+        // 9.6.2.1.4: an acknowledged sequence sent, and the far end's
+        // acknowledgement or Ed heard: E2u.
+        if self.acknowledged_sent > 0 && (self.far_acknowledged || self.ed) {
+            self.start(Up::E2u);
+            return true;
+        }
+        // 9.6.2.1.3: no acknowledgement of a CPu sent 100 ms and a round trip
+        // ago: CPu over and over.
+        if let Some(ended) = self.cpu_ended
+            && !self.far_acknowledged
+            && self.count > ended + 800 + self.round_trip
+        {
+            self.repeat_cpu = true;
+        }
+        let send_cpu = self.cpu.is_some()
+            && self.suvd_heard
+            && (self.cpu_sent == 0 || self.repeat_cpu || (acknowledging && self.acknowledged_sent == 0));
+        let bits = if send_cpu {
+            let cp = self.cpu.as_ref().expect("checked");
+            let cp = if acknowledging { cp.acknowledged() } else { cp.clone() };
+            self.cpu_sent += 1;
+            if self.cpu_sent == 1 {
+                self.began = Some("sent CPu".into());
+            }
+            sequences::cp_bits(&cp, CpKind::Data)
+        } else {
+            Suv { wait_for_cpu: false, level: Suv::UNMEASURED, silence: false, acknowledge: acknowledging }.to_bits(true)
+        };
+        if send_cpu {
+            self.cpu_ended = Some(self.count + bits.len() / self.trn2.as_ref().map_or(2, Trn2::bits_per_symbol));
+        }
+        if acknowledging {
+            self.acknowledged_sent += 1;
+        }
+        self.queue.extend(bits);
+        false
+    }
+}
