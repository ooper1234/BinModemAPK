diff --git a/crates/modem/tests/v92_quick.rs b/crates/modem/tests/v92_quick.rs
new file mode 100644
index 0000000..f74f3b7
--- /dev/null
+++ b/crates/modem/tests/v92_quick.rs
@@ -0,0 +1,203 @@
+//! V.92's Quick Connect from the terminal: dial a V.92 server once, which
+//! is a full start-up and teaches the modem the server; dial it again, and
+//! the call goes through V.92's short Phase 1 and short Phase 2 and comes up
+//! sooner.
+
+use datapump::v8 as v8line;
+use datapump::v34::info::{Info0, Info0d};
+use datapump::v90::network::Network;
+use datapump::v90::startup::{Digital, Status};
+use datapump::v90::ucode::Law;
+use ec::stack::Stack;
+use ec::{Params, Role as EcRole};
+use modem::{Modem, State};
+use v8::{Access, CallFunction, Modulation, Modulations, Pcm};
+
+const FS: f64 = 16_000.0;
+const NETWORK_FS: f64 = 8000.0;
+
+/// A V.92 server: V.8, or V.92's short Phase 1, then V.92's Phase 2.
+struct Server {
+    v8: Option<v8line::Modem>,
+    startup: Option<Digital>,
+    ec: Option<Stack>,
+    received: Vec<u8>,
+    ticks: u64,
+    quick: bool,
+}
+
+impl Server {
+    fn new() -> Self {
+        let v8 = v8line::Modem::new(
+            v8line::Role::Answering,
+            CallFunction::Data,
+            Modulations::of(&[Modulation::V34Duplex, Modulation::V32bis]),
+            NETWORK_FS,
+        )
+        .offering_lapm()
+        .offering_pcm_on(Pcm { digital: true, ..Pcm::default() }, Access { digital: true, ..Access::default() })
+        .answering_quick_connect();
+        Self { v8: Some(v8), startup: None, ec: None, received: Vec::new(), ticks: 0, quick: false }
+    }
+
+    fn info0d() -> Info0d {
+        Info0d {
+            v34: Info0 { constellation_1664: true, ..Info0::default() },
+            nominal_power: 4,
+            max_power: 23,
+            power_at_codec: true,
+            a_law: false,
+            upstream_3429: false,
+            v92: true,
+            short_phase2: true,
+        }
+    }
+
+    fn step(&mut self, input: f64) -> f64 {
+        self.ticks += 1;
+        if let Some(v8) = self.v8.as_mut() {
+            let out = 0.3 * v8.step(input);
+            match v8.status() {
+                v8line::Status::Negotiating => {}
+                v8line::Status::Agreed(_) => {
+                    self.v8 = None;
+                    self.startup = Some(Digital::new(Self::info0d()));
+                }
+                v8line::Status::QuickConnect { .. } => {
+                    self.v8 = None;
+                    self.quick = true;
+                    self.startup = Some(Digital::quick(Self::info0d()));
+                }
+                other => panic!("V.8 came to {other:?}"),
+            }
+            return out;
+        }
+        let startup = self.startup.as_mut().expect("V.8 is over");
+        let out = startup.step(input);
+        if let Status::Connected { transmit, receive } = startup.status() {
+            let stack = self.ec.get_or_insert_with(|| {
+                let params = Params { t401_ms: ec::lapm::t401_for_line(transmit.min(receive), 60), ..Params::default() };
+                Stack::new(EcRole::Answerer, params).over_a_round_trip(60)
+            });
+            for bit in startup.take_bits() {
+                stack.feed_bit(bit);
+            }
+            while startup.pending_bits() < 256 {
+                let bits: Vec<bool> = (0..64).map(|_| stack.next_bit()).collect();
+                startup.send_bits(&bits);
+            }
+            if self.ticks.is_multiple_of(8) {
+                stack.tick(1);
+            }
+            self.received.extend(stack.take_received());
+        }
+        out
+    }
+}
+
+struct Call {
+    net: Network,
+    caller: Modem,
+    server: Server,
+    up: Vec<f64>,
+    said: Vec<u8>,
+    notes: Vec<String>,
+}
+
+impl Call {
+    fn new(memory: &std::path::Path) -> Self {
+        let mut caller = Modem::new(FS);
+        caller.set_quick_connect_file(memory.to_path_buf());
+        Self {
+            net: Network::new(Law::Mu, FS).with_delay(0.015, FS).with_noise(1e-5),
+            caller,
+            server: Server::new(),
+            up: Vec::new(),
+            said: Vec::new(),
+            notes: Vec::new(),
+        }
+    }
+
+    fn type_at(&mut self, line: &str) {
+        for b in line.bytes() {
+            self.caller.feed_dte(b);
+        }
+        self.caller.feed_dte(b'\r');
+    }
+
+    /// Run until the caller is online or `seconds` are up; how long it took.
+    fn run_until_online(&mut self, seconds: f64) -> Option<f64> {
+        for n in 0..(seconds * NETWORK_FS) as usize {
+            let to_server = self.net.up(&self.up);
+            self.up.clear();
+            let from_server = self.server.step(to_server);
+            for x in self.net.down(from_server) {
+                self.up.push(self.caller.step(x));
+                self.said.extend(self.caller.take_dte());
+                self.notes.extend(self.caller.take_line_notes());
+            }
+            if self.caller.state() == State::Data {
+                return Some(n as f64 / NETWORK_FS);
+            }
+        }
+        None
+    }
+
+    fn run(&mut self, seconds: f64) {
+        let _ = self.run_until_online(0.0);
+        for _ in 0..(seconds * NETWORK_FS) as usize {
+            let to_server = self.net.up(&self.up);
+            self.up.clear();
+            let from_server = self.server.step(to_server);
+            for x in self.net.down(from_server) {
+                self.up.push(self.caller.step(x));
+                self.said.extend(self.caller.take_dte());
+            }
+        }
+    }
+
+    fn saw(&self) -> String {
+        String::from_utf8_lossy(&self.said).into_owned()
+    }
+}
+
+/// Dial once in full, then again with Quick Connect: the second call goes
+/// the short way, carries text, and is online sooner.
+#[test]
+fn the_second_call_to_a_v92_server_quick_connects() {
+    let dir = std::env::temp_dir().join(format!("binmodem-v92-{}", std::process::id()));
+    let _ = std::fs::create_dir_all(&dir);
+    let memory = dir.join("quick-connect");
+    let _ = std::fs::remove_file(&memory);
+
+    let mut first = Call::new(&memory);
+    first.type_at("AT+MS=V90");
+    first.run(0.05);
+    first.type_at("ATD5551234");
+    let full = first.run_until_online(30.0).unwrap_or_else(|| panic!("the first call never came up: {:?}", first.saw()));
+    assert!(!first.server.quick, "the first call quick connected with nothing learned");
+    let kept = std::fs::read_to_string(&memory).expect("nothing was kept for the number");
+    assert!(kept.starts_with("5551234 "), "{kept:?}");
+
+    let mut second = Call::new(&memory);
+    second.type_at("AT+MS=V90");
+    second.run(0.05);
+    second.type_at("ATD5551234");
+    let quick = second.run_until_online(30.0).unwrap_or_else(|| panic!("the second call never came up: {:?}", second.saw()));
+    println!("full start-up online at {full:.2} s, quick connect at {quick:.2} s; notes {:?}", second.notes);
+    assert!(second.server.quick, "the second call did not quick connect");
+    assert!(second.notes.iter().any(|n| n.contains("short phase 2 done")), "{:?}", second.notes);
+    assert_eq!(second.caller.standard(), "V.90");
+    assert!(second.caller.rate().is_some_and(|r| r >= 48_000), "{:?}", second.caller.rate());
+    assert!(quick < full - 1.0, "{quick:.2} s is not much quicker than {full:.2} s");
+
+    // And it carries data, over LAPM with no ODP/ADP.
+    second.run(3.0);
+    for b in b"quick hello" {
+        second.caller.feed_dte(*b);
+    }
+    second.run(3.0);
+    let got = String::from_utf8_lossy(&second.server.received).into_owned();
+    assert!(got.contains("quick hello"), "the server got {got:?}");
+    let _ = std::fs::remove_dir_all(&dir);
+}
