diff --git a/crates/datapump/src/v92/finder.rs b/crates/datapump/src/v92/finder.rs
new file mode 100644
index 0000000..bfc701e
--- /dev/null
+++ b/crates/datapump/src/v92/finder.rs
@@ -0,0 +1,131 @@
+//! Finding V.92's framed sequences in a stream of descrambled bits.
+//!
+//! Every one begins with seventeen ones and a start bit of 0 (8.5 to 8.8/
+//! V.92), and bit 18 says which of two it is: in phase 4 an SUV (1) or a CP
+//! (0), each way. How long the rest is follows from its first blocks. Every
+//! place that could be a start is kept until enough has arrived to read it
+//! there, as V.90's finder does.
+
+use crate::v90::sequences::{BLOCK, SYNC_ONES};
+
+use super::sequences::{self, Cpd, Suv, SUV_BITS};
+use crate::v90::sequences::Cp;
+
+/// What was found.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Found {
+    Suv(Suv),
+    /// From the digital modem.
+    Cpd(Cpd),
+    /// From the analogue modem: CPt, CPu or CPus, and what it said.
+    Cp(sequences::CpKind, Cp),
+}
+
+/// Which way the bits are going: what a CP in them is.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Direction {
+    /// From the digital modem: SUVd and CPd.
+    Down,
+    /// From the analogue modem: SUVu, CPt, CPu and CPus.
+    Up,
+}
+
+#[derive(Debug, Clone)]
+pub struct Finder {
+    direction: Direction,
+    bits: Vec<bool>,
+    ones: usize,
+    starts: Vec<usize>,
+}
+
+impl Finder {
+    pub fn new(direction: Direction) -> Self {
+        Self { direction, bits: Vec::new(), ones: 0, starts: Vec::new() }
+    }
+
+    fn length(&self, bits: &[bool]) -> usize {
+        if bits.len() <= SYNC_ONES + 1 {
+            return SYNC_ONES + 2;
+        }
+        if bits[SYNC_ONES + 1] {
+            return SUV_BITS;
+        }
+        match self.direction {
+            Direction::Down => Cpd::length(bits),
+            Direction::Up => sequences::cp_length(bits),
+        }
+    }
+
+    fn parse(&self, bits: &[bool]) -> Option<Found> {
+        if bits[SYNC_ONES + 1] {
+            return Suv::from_bits(bits).map(Found::Suv);
+        }
+        match self.direction {
+            Direction::Down => Cpd::from_bits(bits).map(Found::Cpd),
+            Direction::Up => sequences::cp_from_bits(bits).map(|(k, cp)| Found::Cp(k, cp)),
+        }
+    }
+
+    pub fn feed(&mut self, bit: bool) -> Option<Found> {
+        // Seventeen ones or more: a sequence may follow ones of its own, as
+        // the first CPt follows its 24 (8.5.1), and its sync is the last 17.
+        if !bit && self.ones >= SYNC_ONES {
+            self.starts.push(self.bits.len() - SYNC_ONES);
+        }
+        self.ones = if bit { self.ones + 1 } else { 0 };
+        self.bits.push(bit);
+        let mut found = None;
+        let mut i = 0;
+        while i < self.starts.len() {
+            let start = self.starts[i];
+            let have = &self.bits[start..];
+            let needed = self.length(have);
+            if have.len() < needed {
+                i += 1;
+                continue;
+            }
+            let parsed = self.parse(&have[..needed]);
+            self.starts.remove(i);
+            if parsed.is_some() {
+                found = parsed;
+                self.starts.clear();
+                break;
+            }
+        }
+        let keep_from = self.starts.first().copied().unwrap_or(self.bits.len().saturating_sub(SYNC_ONES));
+        if keep_from > 8192 {
+            self.bits.drain(..keep_from);
+            for s in &mut self.starts {
+                *s -= keep_from;
+            }
+        }
+        // A CP the size of six constellations and their codec copies is under
+        // 3000 bits; a start that has waited longer was never one.
+        let limit = self.bits.len().saturating_sub(4000);
+        self.starts.retain(|&s| s >= limit);
+        found
+    }
+}
+
+/// Bits enough for any sequence's first blocks to say its length.
+pub const HEADER: usize = SYNC_ONES + 8 * (BLOCK + 1);
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::v34::trellis::Code;
+
+    #[test]
+    fn suvs_and_cpds_are_found_among_noise() {
+        let suv = Suv { wait_for_cpu: false, level: Suv::UNMEASURED, silence: false, acknowledge: true };
+        let cpd = Cpd { drn: 10, code: Code::States16, extend_e2u: false, acknowledge: false, gain: 0.0078125, moduli: Some([9; 12]), filters: None, constellations: None };
+        let mut stream: Vec<bool> = (0..300).map(|i| i % 3 == 0).collect();
+        stream.extend(suv.to_bits(false));
+        stream.extend((0..50).map(|i| i % 2 == 0));
+        stream.extend(cpd.to_bits());
+        stream.extend([true; 40]);
+        let mut finder = Finder::new(Direction::Down);
+        let found: Vec<Found> = stream.into_iter().filter_map(|b| finder.feed(b)).collect();
+        assert_eq!(found, vec![Found::Suv(suv), Found::Cpd(cpd)]);
+    }
+}
