diff --git a/crates/modem/src/quick.rs b/crates/modem/src/quick.rs
new file mode 100644
index 0000000..70f85c1
--- /dev/null
+++ b/crates/modem/src/quick.rs
@@ -0,0 +1,136 @@
+//! What V.92's Quick Connect needs to remember between calls (9.2, 9.4/V.92).
+//!
+//! A short Phase 2 has no line probe, so the upstream the analogue modem asks
+//! for in it is the one the last full start-up with the same server settled.
+//! That is kept here, a line per number dialled, in a file beside the
+//! program's other settings: `BINMODEM_QUICK_CONNECT` names it, or it is
+//! `BinModem/quick-connect` in the per-user configuration directory.
+//!
+//! A number with nothing kept is dialled as V.90 always was. One whose Quick
+//! Connect does not reach data mode is forgotten, so the next call to it
+//! starts in full and learns afresh.
+
+use std::collections::BTreeMap;
+use std::path::PathBuf;
+
+use datapump::v34::info::SymbolRate;
+use datapump::v34::phase2::Recall;
+
+/// Where the file is, if anywhere.
+fn path() -> Option<PathBuf> {
+    if let Some(p) = std::env::var_os("BINMODEM_QUICK_CONNECT") {
+        return Some(PathBuf::from(p));
+    }
+    let base = std::env::var_os("APPDATA")
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("XDG_CONFIG_HOME").map(PathBuf::from))
+        .or_else(|| std::env::var_os("HOME").map(|h| PathBuf::from(h).join(".config")))?;
+    Some(base.join("BinModem").join("quick-connect"))
+}
+
+/// A number as it is kept: what was dialled, without the spaces and dashes
+/// people write numbers with.
+pub fn key(number: &str) -> String {
+    number.chars().filter(|c| !c.is_whitespace() && *c != '-').collect()
+}
+
+/// Every number with a Quick Connect to offer.
+#[derive(Debug, Default, Clone)]
+pub struct Memory {
+    numbers: BTreeMap<String, Recall>,
+    file: Option<PathBuf>,
+}
+
+impl Memory {
+    /// Whatever the file holds. A missing or unreadable file is an empty
+    /// memory, and a line that will not read is skipped.
+    pub fn load() -> Self {
+        Self::at(path())
+    }
+
+    /// The same, from and to a file of one's own choosing.
+    pub fn at(file: Option<PathBuf>) -> Self {
+        let mut memory = Self { file, ..Self::default() };
+        let Some(text) = memory.file.as_ref().and_then(|p| std::fs::read_to_string(p).ok()) else { return memory };
+        for line in text.lines() {
+            if let Some((number, recall)) = parse(line) {
+                memory.numbers.insert(number, recall);
+            }
+        }
+        memory
+    }
+
+    fn save(&self) {
+        let Some(path) = self.file.as_ref() else { return };
+        if let Some(dir) = path.parent() {
+            let _ = std::fs::create_dir_all(dir);
+        }
+        let text: String = self.numbers.iter().map(|(n, r)| format!("{}\n", show(n, r))).collect();
+        let _ = std::fs::write(path, text);
+    }
+
+    pub fn get(&self, number: &str) -> Option<Recall> {
+        self.numbers.get(&key(number)).copied()
+    }
+
+    pub fn remember(&mut self, number: &str, recall: Recall) {
+        if self.numbers.insert(key(number), recall) != Some(recall) {
+            self.save();
+        }
+    }
+
+    pub fn forget(&mut self, number: &str) {
+        if self.numbers.remove(&key(number)).is_some() {
+            self.save();
+        }
+    }
+}
+
+/// `number symbol-rate-index high-carrier pre-emphasis max-rate power-reduction round-trip-ms`
+fn show(number: &str, r: &Recall) -> String {
+    format!(
+        "{number} {} {} {} {} {} {}",
+        r.upstream.index(),
+        u8::from(r.high_carrier),
+        r.pre_emphasis,
+        r.max_rate,
+        r.power_reduction,
+        r.round_trip_ms
+    )
+}
+
+fn parse(line: &str) -> Option<(String, Recall)> {
+    let mut f = line.split_whitespace();
+    let number = f.next()?.to_owned();
+    let mut n = || f.next()?.parse::<u32>().ok();
+    let upstream = SymbolRate::from_index(n()?)?;
+    let recall = Recall {
+        upstream,
+        high_carrier: n()? != 0,
+        pre_emphasis: u8::try_from(n()?).ok()?,
+        max_rate: u8::try_from(n()?).ok()?,
+        power_reduction: u8::try_from(n()?).ok()?,
+        round_trip_ms: n()?,
+    };
+    Some((number, recall))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_line_reads_back_as_it_was_written() {
+        let r = Recall {
+            upstream: SymbolRate::S3200,
+            high_carrier: true,
+            pre_emphasis: 3,
+            max_rate: 13,
+            power_reduction: 1,
+            round_trip_ms: 812,
+        };
+        assert_eq!(parse(&show("16165551234", &r)), Some(("16165551234".to_owned(), r)));
+        assert_eq!(key("1 616-555 1234"), "16165551234");
+        assert_eq!(parse("garbage"), None);
+    }
+}
