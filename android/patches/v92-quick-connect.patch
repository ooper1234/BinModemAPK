new file mode 100644
index 0000000..8a4e179
--- /dev/null
+++ b/crates/datapump/src/v92/sequences.rs
@@ -0,0 +1,609 @@
+//! V.92's information sequences for PCM upstream (8.5 to 8.8/V.92): CPd,
+//! CPt and CPu, CPus, SUVu and SUVd, Jp, and the DIL descriptor with its
+//! upstream rate mask.
+//!
+//! All are framed as V.90's are -- seventeen ones, sixteen-bit blocks each
+//! after a start bit of 0, a start bit and V.34's CRC -- and are built here
+//! on V.90's own framing.
+
+use crate::v34::trellis::Code;
+use crate::v90::sequences::{Cp, Descriptor, Mask, BLOCK, SYNC_ONES, frame, get, put, unframe};
+use crate::v90::sign::Redundancy;
+
+use super::transmitter::{Constellation, FRAME, Params};
+
+/// Where block `block`'s bit `bit` is, counting from the frame sync.
+fn at(block: usize, bit: usize) -> usize {
+    SYNC_ONES + block * (BLOCK + 1) + 1 + bit
+}
+
+/// Fill to a whole number of `multiple` bits with zeros, after the one
+/// fill bit every sequence ends with.
+fn fill(mut bits: Vec<bool>, multiple: usize) -> Vec<bool> {
+    bits.push(false);
+    while bits.len() % multiple != 0 {
+        bits.push(false);
+    }
+    bits
+}
+
+/// Signed fixed point with `fraction` bits after the point, as sixteen bits.
+fn to_fixed(value: f64, fraction: u32) -> u32 {
+    let scaled = (value * f64::from(1u32 << fraction)).round().clamp(-32768.0, 32767.0) as i32;
+    (scaled as i16 as u16).into()
+}
+
+fn from_fixed(bits: u32, fraction: u32) -> f64 {
+    f64::from(bits as u16 as i16) / f64::from(1u32 << fraction)
+}
+
+/// CPd (Table 30/V.92): what the digital modem tells the analogue modem to
+/// send with. The three optional parts are present when Some.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Cpd {
+    /// Bits 22:26: the upstream drn, 0 for cleardown; the rate is
+    /// (drn + 17) * 8000/6.
+    pub drn: u8,
+    /// Bits 27:28.
+    pub code: Code,
+    /// Bit 29: E2u one symbol longer.
+    pub extend_e2u: bool,
+    /// Bit 33.
+    pub acknowledge: bool,
+    /// Bits 35:50: 4G in unsigned Q0.16, kept as G.
+    pub gain: f64,
+    /// M0 to M11.
+    pub moduli: Option<[u8; FRAME]>,
+    /// z1(1..), p1(1..), z2(0..), p2(1..).
+    pub filters: Option<Filters>,
+    /// Which set each interval and the one six after it use, and the sets,
+    /// each its positive points smallest first.
+    pub constellations: Option<([u8; 6], Vec<Vec<u16>>)>,
+}
+
+#[derive(Debug, Clone, PartialEq, Default)]
+pub struct Filters {
+    pub z1: Vec<f64>,
+    pub p1: Vec<f64>,
+    pub z2: Vec<f64>,
+    pub p2: Vec<f64>,
+}
+
+impl Cpd {
+    /// The upstream rate in bit/s, or None for cleardown.
+    pub fn rate(&self) -> Option<u32> {
+        (self.drn > 0).then(|| (u32::from(self.drn) + 17) * 8000 / 6)
+    }
+
+    pub fn acknowledged(&self) -> Self {
+        Self { acknowledge: true, ..self.clone() }
+    }
+
+    /// The transmitter's parameters, when every part has been sent (this
+    /// one, or the last CPd that carried them).
+    pub fn params(&self) -> Option<Params> {
+        let moduli = self.moduli?;
+        let filters = self.filters.clone()?;
+        let (intervals, sets) = self.constellations.clone()?;
+        let set = |i: usize| -> Constellation {
+            let index = usize::from(intervals[i % 6]);
+            Constellation { positive: sets.get(index).map(|s| s.iter().map(|&p| f64::from(p)).collect()).unwrap_or_default() }
+        };
+        let params = Params {
+            bits: 2 * (usize::from(self.drn) + 17),
+            moduli: moduli.map(u32::from),
+            constellations: std::array::from_fn(set),
+            z1: filters.z1,
+            p1: filters.p1,
+            z2: filters.z2,
+            p2: filters.p2,
+            gain: self.gain,
+            code: self.code,
+        };
+        params.valid().then_some(params)
+    }
+
+    pub fn to_bits(&self) -> Vec<bool> {
+        let mut info = Vec::new();
+        info.push(false); // 18: CPd
+        info.push(self.moduli.is_some());
+        info.push(self.filters.is_some());
+        info.push(self.constellations.is_some());
+        put(&mut info, u32::from(self.drn), 5);
+        put(&mut info, match self.code {
+            Code::States16 => 0,
+            Code::States32 => 1,
+            Code::States64 => 2,
+        }, 2);
+        info.push(self.extend_e2u);
+        put(&mut info, 0, 3);
+        info.push(self.acknowledge);
+        put(&mut info, ((4.0 * self.gain * 65536.0).round() as u32).min(0xffff), 16);
+        if let Some(m) = self.moduli {
+            for v in m {
+                put(&mut info, u32::from(v), 8);
+            }
+        }
+        if let Some(f) = &self.filters {
+            for len in [f.z1.len(), f.p1.len(), f.z2.len(), f.p2.len()] {
+                put(&mut info, len as u32, 9);
+                put(&mut info, 0, 7);
+            }
+            for &z in &f.z1 {
+                put(&mut info, to_fixed(z, 15), 16);
+            }
+            for &p in &f.p1 {
+                put(&mut info, to_fixed(p, 14), 16);
+            }
+            for &z in &f.z2 {
+                put(&mut info, to_fixed(z, 15), 16);
+            }
+            for &p in &f.p2 {
+                put(&mut info, to_fixed(p, 14), 16);
+            }
+        }
+        if let Some((intervals, sets)) = &self.constellations {
+            for i in intervals {
+                put(&mut info, u32::from(*i), 4);
+            }
+            put(&mut info, 0, 8);
+            for k in 0..6 {
+                put(&mut info, sets.get(k).map_or(0, |s| s.len() as u32), 8);
+            }
+            for set in sets.iter().take(6) {
+                for &p in set {
+                    put(&mut info, u32::from(p), 16);
+                }
+            }
+        }
+        // "Fill bits: 0s to extend the CPd sequence length to the next
+        // multiple of 6 symbols": downstream, a bit a symbol.
+        fill(frame(&info), 6)
+    }
+
+    /// The blocks this CPd has, from its first and, when present, the
+    /// blocks giving the filter lengths and the constellation sizes.
+    fn blocks(bits: &[bool]) -> Option<usize> {
+        let need = |n: usize| bits.len() >= at(n, 0) + BLOCK;
+        if !need(1) {
+            return None;
+        }
+        let (moduli, filters, sets) = (bits[at(0, 1)], bits[at(0, 2)], bits[at(0, 3)]);
+        let mut blocks = 2 + if moduli { 6 } else { 0 };
+        if filters {
+            if !need(blocks + 3) {
+                return None;
+            }
+            let taps: usize = (0..4).map(|k| get(bits, at(blocks + k, 0), 9) as usize).sum();
+            blocks += 4 + taps;
+        }
+        if sets {
+            if !need(blocks + 4) {
+                return None;
+            }
+            let points: usize = (0..6)
+                .map(|k| {
+                    let (block, bit) = (blocks + 2 + k / 2, 8 * (k % 2));
+                    get(bits, at(block, bit), 8) as usize
+                })
+                .sum();
+            blocks += 5 + points;
+        }
+        Some(blocks)
+    }
+
+    /// The bits a whole CPd starting at `bits` takes, once its headers are
+    /// there to say; a guess that asks for more until then.
+    pub fn length(bits: &[bool]) -> usize {
+        match Self::blocks(bits) {
+            Some(blocks) => SYNC_ONES + (blocks + 1) * (BLOCK + 1),
+            None => bits.len() + BLOCK,
+        }
+    }
+
+    pub fn from_bits(bits: &[bool]) -> Option<Self> {
+        if bits.get(at(0, 0)) != Some(&false) {
+            return None;
+        }
+        let blocks = Self::blocks(bits)?;
+        let info = unframe(bits, blocks)?;
+        let code = match get(&info, 9, 2) {
+            0 => Code::States16,
+            1 => Code::States32,
+            2 => Code::States64,
+            _ => return None,
+        };
+        let mut from = 2 * BLOCK;
+        let moduli = info[1].then(|| {
+            let m = std::array::from_fn(|k| get(&info, from + 8 * k, 8) as u8);
+            from += 6 * BLOCK;
+            m
+        });
+        let filters = info[2].then(|| {
+            let lens: Vec<usize> = (0..4).map(|k| get(&info, from + BLOCK * k, 9) as usize).collect();
+            from += 4 * BLOCK;
+            let mut take = |n: usize, fraction: u32| -> Vec<f64> {
+                let v = (0..n).map(|k| from_fixed(get(&info, from + BLOCK * k, 16), fraction)).collect();
+                from += n * BLOCK;
+                v
+            };
+            let z1 = take(lens[0], 15);
+            let p1 = take(lens[1], 14);
+            let z2 = take(lens[2], 15);
+            let p2 = take(lens[3], 14);
+            Filters { z1, p1, z2, p2 }
+        });
+        let constellations = info[3].then(|| {
+            let intervals = std::array::from_fn(|k| get(&info, from + 4 * k, 4) as u8);
+            from += 2 * BLOCK;
+            let sizes: Vec<usize> = (0..6).map(|k| get(&info, from + 8 * k, 8) as usize).collect();
+            from += 3 * BLOCK;
+            let sets = sizes
+                .iter()
+                .filter(|&&n| n > 0)
+                .map(|&n| {
+                    let s = (0..n).map(|k| get(&info, from + BLOCK * k, 16) as u16).collect();
+                    from += n * BLOCK;
+                    s
+                })
+                .collect();
+            (intervals, sets)
+        });
+        Some(Self {
+            drn: get(&info, 4, 5) as u8,
+            code,
+            extend_e2u: info[11],
+            acknowledge: info[15],
+            gain: f64::from(get(&info, 16, 16)) / 65536.0 / 4.0,
+            moduli,
+            filters,
+            constellations,
+        })
+    }
+}
+
+/// Which of Table 23's CP sequences: CPt, CPu, or Table 24's short CPus.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CpKind {
+    Training,
+    Data,
+    Short,
+}
+
+/// A V.92 CP: V.90's from bit 34 on, with V.92's first block -- the type in
+/// bits 19:20 and the rate in 21:25 (Table 23/V.92). V.90's upstream rates
+/// in 36:48 are reserved, since V.92's are in Ja.
+pub fn cp_bits(cp: &Cp, kind: CpKind) -> Vec<bool> {
+    let mut info = Vec::new();
+    info.push(false); // 18: CP
+    put(&mut info, match kind {
+        CpKind::Training => 0,
+        CpKind::Data => 1,
+        CpKind::Short => 2,
+    }, 2);
+    put(&mut info, u32::from(cp.drn), 5);
+    if kind == CpKind::Short {
+        put(&mut info, 0, 7); // 26:32 reserved
+        info.push(cp.acknowledge);
+        // "Fill bits: 0s ... to the next multiple of 12 symbols": at two
+        // bits a symbol on TRN2u's four points, 24 bits.
+        return fill(frame(&info), 24);
+    }
+    put(&mut info, 0, 5); // 26:30 reserved
+    put(&mut info, cp.redundancy.spent() as u32, 2);
+    info.push(cp.acknowledge);
+    info.push(cp.a_law);
+    put(&mut info, 0, 13); // 36:48 reserved
+    put(&mut info, u32::from(cp.lookahead), 2);
+    put(&mut info, u32::from(cp.trn1d_ratio), 16);
+    for coefficient in cp.shaping {
+        put(&mut info, u32::from(coefficient as u8), 8);
+    }
+    for index in cp.intervals {
+        put(&mut info, u32::from(index), 4);
+    }
+    info.push(cp.codec.is_some());
+    put(&mut info, 0, 7);
+    let count = usize::from(cp.intervals.iter().copied().max().unwrap_or(0)) + 1;
+    let wanted = if cp.codec.is_some() { 2 * count } else { count };
+    for mask in cp.constellations.iter().chain(cp.codec.iter().flatten()).take(wanted) {
+        for chord in 0..8 {
+            put(&mut info, (mask >> (16 * chord)) as u32 & 0xffff, 16);
+        }
+    }
+    fill(frame(&info), 24)
+}
+
+/// A V.92 CP back, for the digital modem: which kind, and its fields as
+/// V.90's [`Cp`] holds them (`data_mode` set for CPu).
+pub fn cp_from_bits(bits: &[bool]) -> Option<(CpKind, Cp)> {
+    if bits.len() < at(1, 0) || bits[at(0, 0)] {
+        return None;
+    }
+    let kind = match get(bits, at(0, 1), 2) {
+        0 => CpKind::Training,
+        1 => CpKind::Data,
+        2 => CpKind::Short,
+        _ => return None,
+    };
+    let drn = get(bits, at(0, 3), 5) as u8;
+    if kind == CpKind::Short {
+        let info = unframe(bits, 1)?;
+        return Some((kind, Cp { data_mode: true, drn, acknowledge: info[15], ..Cp::default() }));
+    }
+    if bits.len() < at(7, 0) {
+        return None;
+    }
+    let intervals: [u8; 6] = std::array::from_fn(|i| {
+        let (block, bit) = if i < 4 { (5, 4 * i) } else { (6, 4 * (i - 4)) };
+        get(bits, at(block, bit), 4) as u8
+    });
+    if intervals.iter().any(|&i| i > 5) {
+        return None;
+    }
+    let codec = bits[at(6, 8)];
+    let count = usize::from(*intervals.iter().max().unwrap_or(&0)) + 1;
+    let masks = if codec { 2 * count } else { count };
+    let info = unframe(bits, 7 + 8 * masks)?;
+    let mask = |k: usize| -> Mask {
+        let from = 7 * BLOCK + k * 8 * BLOCK;
+        (0..8).fold(0, |m, chord| m | Mask::from(get(&info, from + chord * BLOCK, 16)) << (16 * chord))
+    };
+    Some((
+        kind,
+        Cp {
+            data_mode: kind == CpKind::Data,
+            drn,
+            silence: false,
+            redundancy: match get(&info, 13, 2) {
+                0 => Redundancy::None,
+                1 => Redundancy::One,
+                2 => Redundancy::Two,
+                _ => Redundancy::Three,
+            },
+            acknowledge: info[15],
+            a_law: info[16],
+            upstream_rates: 0,
+            lookahead: get(&info, 30, 2) as u8,
+            trn1d_ratio: get(&info, 32, 16) as u16,
+            shaping: std::array::from_fn(|k| get(&info, 48 + 8 * k, 8) as u8 as i8),
+            intervals,
+            constellations: (0..count).map(mask).collect(),
+            codec: codec.then(|| (count..2 * count).map(mask).collect()),
+        },
+    ))
+}
+
+/// A V.92 CP's length from its first seven blocks, as V.90's.
+pub fn cp_length(bits: &[bool]) -> usize {
+    if bits.len() >= at(0, 3) && get(bits, at(0, 1), 2) == 2 {
+        return SYNC_ONES + 2 * (BLOCK + 1);
+    }
+    if bits.len() <= at(6, 8) {
+        return bits.len() + BLOCK;
+    }
+    let largest = (0..6)
+        .map(|i| {
+            let (block, bit) = if i < 4 { (5, 4 * i) } else { (6, 4 * (i - 4)) };
+            get(bits, at(block, bit), 4) as usize
+        })
+        .max()
+        .unwrap_or(0)
+        .min(5);
+    let masks = if bits[at(6, 8)] { 2 * (largest + 1) } else { largest + 1 };
+    SYNC_ONES + (7 + 8 * masks + 1) * (BLOCK + 1)
+}
+
+/// SUVu and SUVd (Tables 27 and 31/V.92).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub struct Suv {
+    /// SUVu bit 26: wait for a CPu before sending a CPd.
+    pub wait_for_cpu: bool,
+    /// SUVu bits 27:31: 20 log10 of the prefilter's RMS times G, signed
+    /// Q2.2; 16 (-4.00) is no measurement.
+    pub level: u8,
+    /// Bit 32: a silent period is asked for.
+    pub silence: bool,
+    /// Bit 33.
+    pub acknowledge: bool,
+}
+
+impl Suv {
+    /// "The value 16 (-4.00) indicates that no measurement has been taken".
+    pub const UNMEASURED: u8 = 16;
+
+    /// `upstream` for SUVu (fill to 12 symbols of two bits), else SUVd (to 6
+    /// symbols of one).
+    pub fn to_bits(&self, upstream: bool) -> Vec<bool> {
+        let mut info = vec![true]; // 18: SUV
+        put(&mut info, 0, 7); // 19:25
+        info.push(self.wait_for_cpu);
+        put(&mut info, u32::from(self.level), 5);
+        info.push(self.silence);
+        info.push(self.acknowledge);
+        fill(frame(&info), if upstream { 24 } else { 6 })
+    }
+
+    pub fn from_bits(bits: &[bool]) -> Option<Self> {
+        let info = unframe(bits, 1)?;
+        if !info[0] {
+            return None;
+        }
+        Some(Self { wait_for_cpu: info[8], level: get(&info, 9, 5) as u8, silence: info[14], acknowledge: info[15] })
+    }
+}
+
+/// The length of anything that begins with one block saying SUV or not.
+pub const SUV_BITS: usize = SYNC_ONES + 2 * (BLOCK + 1);
+
+/// Jp (Table 22/V.92): how far the digital modem wants Su extended, and the
+/// sizes of TRN2u.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Jp {
+    /// Bits 18:33: the fraction of a symbol, [0, 1).
+    pub fraction: f64,
+    /// Bits 48 and 49: eight points for CPu, E2u, SUVu and TRN2u in training,
+    /// and in rate renegotiation; four otherwise.
+    pub eight_in_training: bool,
+    pub eight_in_renegotiation: bool,
+}
+
+/// Jd and Jp are 72 bits each (Tables 21 and 22/V.92).
+pub const JP_BITS: usize = 72;
+
+impl Jp {
+    pub fn to_bits(&self) -> Vec<bool> {
+        let mut info = Vec::new();
+        put(&mut info, ((self.fraction * 65536.0) as u32).min(0xffff), 16);
+        put(&mut info, 0, 12); // 35:46
+        info.push(true); // 47: Jp
+        info.push(self.eight_in_training);
+        info.push(self.eight_in_renegotiation);
+        info.push(false);
+        let mut bits = frame(&info);
+        bits.resize(JP_BITS, false);
+        bits
+    }
+
+    /// A Jp, and only a Jp: bit 47 says Jd or Jp.
+    pub fn from_bits(bits: &[bool]) -> Option<Self> {
+        let info = unframe(bits, 2)?;
+        if !info[28] {
+            return None;
+        }
+        Some(Self {
+            fraction: f64::from(get(&info, 0, 16)) / 65536.0,
+            eight_in_training: info[29],
+            eight_in_renegotiation: info[30],
+        })
+    }
+}
+
+/// Upstream rates the analogue modem's transmitter has enabled, in Ja's DIL
+/// descriptor (Table 20/V.92): bit 0 for 24 000 up to bit 18 for 48 000.
+pub const ALL_UPSTREAM_RATES: u32 = (1 << 19) - 1;
+
+/// Ja's DIL descriptor for V.92: V.90's, the upstream rate mask in two
+/// blocks after it, then the CRC; filled to whole twelve-bit groups ("Ja
+/// shall be an integer multiple of 12 bits long").
+pub fn descriptor_bits(descriptor: &Descriptor, rates: u32) -> Vec<bool> {
+    let mut info = descriptor.information();
+    put(&mut info, rates & 0xffff, 16);
+    put(&mut info, rates >> 16 & 0x7, 3);
+    put(&mut info, 0, 13);
+    fill(frame(&info), 12)
+}
+
+/// The same back, for the digital modem: the descriptor and the mask.
+pub fn descriptor_from_bits(bits: &[bool]) -> Option<(Descriptor, u32)> {
+    if bits.len() < SYNC_ONES + 2 * (BLOCK + 1) {
+        return None;
+    }
+    let n = get(bits, at(0, 0), 8) as usize;
+    let lsp = get(bits, at(1, 0), 7) as usize + 1;
+    let ltp = get(bits, at(1, 8), 7) as usize + 1;
+    let blocks = 2 + lsp.div_ceil(BLOCK) + ltp.div_ceil(BLOCK) + 8 + n.div_ceil(2);
+    let info = unframe(bits, blocks + 2)?;
+    // V.90's own reader wants its own CRC after its blocks: give it one.
+    let mut v90 = frame(&info[..blocks * BLOCK]);
+    v90.push(false);
+    let descriptor = Descriptor::from_bits(&v90)?;
+    let rates = get(&info, blocks * BLOCK, 16) | get(&info, blocks * BLOCK + 16, 3) << 16;
+    Some((descriptor, rates))
+}
+
+/// Its length from its first two blocks.
+pub fn descriptor_length(bits: &[bool]) -> usize {
+    if bits.len() < SYNC_ONES + 2 * (BLOCK + 1) {
+        return bits.len() + BLOCK;
+    }
+    let n = get(bits, at(0, 0), 8) as usize;
+    let lsp = get(bits, at(1, 0), 7) as usize + 1;
+    let ltp = get(bits, at(1, 8), 7) as usize + 1;
+    let blocks = 2 + lsp.div_ceil(BLOCK) + ltp.div_ceil(BLOCK) + 8 + n.div_ceil(2) + 2;
+    SYNC_ONES + (blocks + 1) * (BLOCK + 1)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_cpd_with_every_part_reads_back() {
+        let cpd = Cpd {
+            drn: 19,
+            code: Code::States32,
+            extend_e2u: true,
+            acknowledge: false,
+            gain: 0.123,
+            moduli: Some([64, 64, 64, 64, 60, 60, 60, 60, 50, 50, 50, 50]),
+            filters: Some(Filters { z1: vec![0.25, -0.125], p1: vec![-0.5], z2: vec![1.0 - 1.0 / 32768.0, 0.0625], p2: vec![] }),
+            constellations: Some(([0, 1, 0, 1, 0, 1], vec![(1..=64).map(|p| p * 50).collect(), (1..=60).map(|p| p * 55).collect()])),
+        };
+        let bits = cpd.to_bits();
+        assert_eq!(bits.len() % 6, 0);
+        // Its length, once the headers are in, is everything up to its CRC.
+        assert!(Cpd::length(&bits) <= bits.len() && bits.len() - Cpd::length(&bits) < 7);
+        let back = Cpd::from_bits(&bits).expect("does not read back");
+        assert_eq!(back.drn, 19);
+        assert_eq!(back.code, Code::States32);
+        assert!((back.gain - 0.123).abs() < 1e-4);
+        assert_eq!(back.moduli, cpd.moduli);
+        assert_eq!(back.filters, cpd.filters);
+        assert_eq!(back.constellations, cpd.constellations);
+        assert_eq!(back.rate(), Some(48_000));
+        // A bit spoiled is no CPd.
+        let mut spoiled = bits.clone();
+        spoiled[200] = !spoiled[200];
+        assert_eq!(Cpd::from_bits(&spoiled), None);
+    }
+
+    #[test]
+    fn a_cpd_with_only_its_first_part_is_short() {
+        let cpd = Cpd { drn: 0, code: Code::States16, extend_e2u: false, acknowledge: true, gain: 0.125, moduli: None, filters: None, constellations: None };
+        let bits = cpd.to_bits();
+        assert_eq!(Cpd::from_bits(&bits), Some(cpd));
+        assert_eq!(Cpd::length(&bits), SYNC_ONES + 3 * (BLOCK + 1));
+    }
+
+    #[test]
+    fn a_v92_cp_has_its_type_and_rate_where_table_23_puts_them() {
+        let cp = Cp {
+            drn: 19,
+            acknowledge: true,
+            intervals: [0, 1, 0, 1, 0, 1],
+            constellations: vec![0xffff_0000, 0xff00],
+            ..Cp::default()
+        };
+        for kind in [CpKind::Training, CpKind::Data] {
+            let bits = cp_bits(&cp, kind);
+            assert_eq!(bits.len() % 24, 0);
+            assert_eq!(get(&bits, 19, 2), if kind == CpKind::Data { 1 } else { 0 });
+            assert_eq!(get(&bits, 21, 5), 19);
+            assert!(bits[33]);
+            assert_eq!(cp_length(&bits), cp_length(&bits[..SYNC_ONES + 7 * (BLOCK + 1)]));
+            let (k, back) = cp_from_bits(&bits).expect("does not read back");
+            assert_eq!(k, kind);
+            assert_eq!((back.drn, back.intervals, back.constellations), (19, cp.intervals, cp.constellations.clone()));
+        }
+        let short = cp_bits(&cp, CpKind::Short);
+        assert_eq!(cp_from_bits(&short).map(|(k, c)| (k, c.drn, c.acknowledge)), Some((CpKind::Short, 19, true)));
+    }
+
+    #[test]
+    fn suv_jp_and_the_descriptor_read_back() {
+        let suv = Suv { wait_for_cpu: true, level: Suv::UNMEASURED, silence: false, acknowledge: true };
+        assert_eq!(Suv::from_bits(&suv.to_bits(true)), Some(suv));
+        assert_eq!(suv.to_bits(true).len() % 24, 0);
+        let jp = Jp { fraction: 0.375, eight_in_training: true, eight_in_renegotiation: false };
+        let bits = jp.to_bits();
+        assert_eq!(bits.len(), JP_BITS);
+        assert_eq!(Jp::from_bits(&bits), Some(jp));
+        assert!(bits[47]);
+        let d = crate::v90::dil::design(crate::v90::ucode::Law::Mu, 79);
+        let bits = descriptor_bits(&d, ALL_UPSTREAM_RATES);
+        assert_eq!(bits.len() % 12, 0);
+        assert_eq!(descriptor_length(&bits[..80]), descriptor_length(&bits));
+        assert_eq!(descriptor_from_bits(&bits), Some((d, ALL_UPSTREAM_RATES)));
+    }
+}
